---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section class="relative overflow-hidden border-b border-line">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="container-page relative pb-16 pt-10 md:pb-24 md:pt-14">
    <div class="flex flex-col gap-3 border-b border-line pb-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="label text-muted">{t.hero.eyebrow}</p>
      <p class="label flex items-center gap-2 text-ink-soft">
        <span class="status-dot"></span>
        {t.hero.availability}
      </p>
    </div>

    <div class="mt-12 grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-8">
        <div class="mb-6 h-2 w-10 bg-accent" aria-hidden="true"></div>

        <h1
          class="font-serif text-[clamp(3rem,8.6vw,7.25rem)] leading-[0.93] tracking-[-0.045em]"
          aria-label={t.hero.titleLines.join(' ')}
        >
          <span class="block">{t.hero.titleLines[0]}</span>
          <span class="block">{t.hero.titleLines[1]}</span>
          <span class="block italic text-accent">{t.hero.titleLines[2]}</span>
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-soft md:text-xl">{t.hero.intro}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#work" class="btn btn-primary">
            {t.hero.primaryCta}
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#contact" class="btn">
            {t.hero.secondaryCta}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <aside class="lg:col-span-4 lg:pl-4 xl:pl-8">
        <div class="border border-line bg-paper-deep/55">
          <div class="flex items-center justify-between border-b border-line px-5 py-3">
            <span class="label">{t.hero.cardLabel}</span>
            <span class="label text-muted">{t.hero.cardVersion}</span>
          </div>

          <dl>
            {t.hero.rows.map((row) => (
              <div class="grid grid-cols-[5.5rem_1fr] gap-3 border-b border-line/70 px-5 py-4">
                <dt class="label pt-0.5 text-muted">{row.label}</dt>
                <dd class="text-[13px] leading-snug text-ink-soft">{row.value}</dd>
              </div>
            ))}
          </dl>

          <div class="flex items-start gap-3 px-5 py-4">
            <span class="status-dot mt-1.5"></span>
            <p class="text-xs leading-relaxed text-muted">{t.hero.cardFootnote}</p>
          </div>
        </div>

        <div class="mt-3 flex items-center justify-between">
          <span class="label text-muted">{t.hero.clockLabel}</span>
          <time class="label text-ink-soft" data-clock>
            --:--
          </time>
        </div>
      </aside>
    </div>
  </div>
</section>
