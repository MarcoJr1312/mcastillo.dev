---
import { content, site, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section id="contact" class="border-t border-accent/30 bg-night text-fg">
  <div class="container-page section-pad">
    <div class="flex items-baseline gap-3 border-t border-white/15 pt-5">
      <span class="label text-accent">{t.contact.index}</span>
      <span class="label text-fg/50">{t.contact.label}</span>
    </div>

    <div class="mt-10 grid gap-10 md:mt-14 lg:grid-cols-12 lg:gap-8">
      <h2 class="font-serif text-[clamp(3rem,8.4vw,7.5rem)] leading-[0.92] tracking-[-0.045em] lg:col-span-8">
        <span class="block">{t.contact.titleLines[0]}</span>
        <span class="block italic text-accent">{t.contact.titleLines[1]}</span>
      </h2>

      <p class="max-w-sm self-end text-sm leading-relaxed text-fg/65 lg:col-span-4">
        {t.contact.intro}
      </p>
    </div>

    <div class="mt-14 grid gap-10 border-t border-white/15 pt-8 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-6">
        <p class="label text-fg/50">{t.contact.emailLabel}</p>
        <a
          href={`mailto:${site.email}`}
          class="link-underline mt-3 inline-block font-serif text-[clamp(1.3rem,4.5vw,2.5rem)] leading-tight text-fg"
        >
          {site.email}
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="md:col-span-3">
        <p class="label text-fg/50">{t.contact.socialLabel}</p>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href={site.github}
              target="_blank"
              rel="noopener noreferrer"
              class="label link-underline text-fg/80 hover:text-fg"
            >
              GitHub <span aria-hidden="true">↗</span>
              <span class="sr-only">
                {lang === 'es' ? '(se abre en una pestaña nueva)' : '(opens in a new tab)'}
              </span>
            </a>
          </li>
          <li>
            <a
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="label link-underline text-fg/80 hover:text-fg"
            >
              LinkedIn <span aria-hidden="true">↗</span>
              <span class="sr-only">
                {lang === 'es' ? '(se abre en una pestaña nueva)' : '(opens in a new tab)'}
              </span>
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <p class="label text-fg/50">{t.contact.locationLabel}</p>
        <p class="mt-3 text-sm leading-relaxed text-fg/80">{site.location}</p>

        <p class="label mt-5 text-fg/50">{t.contact.timeLabel}</p>
        <time class="label mt-2 block text-fg/80" data-clock>
          --:--
        </time>
      </div>
    </div>

    <div class="mt-10 flex items-center gap-2">
      <span class="h-1.5 w-1.5 flex-none bg-accent" aria-hidden="true"></span>
      <span class="label text-fg/60">{t.contact.availability}</span>
    </div>
  </div>
</section>
