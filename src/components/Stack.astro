---
import { content, type Lang } from '../i18n/content';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section id="stack" class="section-pad">
  <div class="container-page">
    <SectionHeading
      index={t.stack.index}
      label={t.stack.label}
      title={t.stack.title}
      note={t.stack.note}
    />

    <div class="mt-8 border-b border-line md:mt-12">
      {t.stack.groups.map((group, index) => (
        <div
          class="grid gap-4 border-t border-line py-6 md:grid-cols-12 md:items-start md:gap-8"
          data-reveal
          style={`--reveal-delay:${index * 40}ms`}
        >
          <h3 class="label text-muted md:col-span-3 md:pt-2">{group.label}</h3>
          <ul class="flex flex-wrap gap-2 md:col-span-9">
            {group.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
