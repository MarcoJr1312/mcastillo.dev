---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const home = lang === 'es' ? '/' : '/en/';
const navLabel = lang === 'es' ? 'Navegación principal' : 'Main navigation';
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/90 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4 md:h-20">
    <a href={home} class="group flex items-center gap-3">
      <span class="relative grid h-10 w-10 place-items-center bg-ink text-paper" aria-hidden="true">
        <span class="font-serif text-xl leading-none">M</span>
        <span class="absolute right-1 top-1 h-1 w-1 bg-accent-light"></span>
      </span>
      <span class="hidden sm:block">
        <span class="block font-serif text-lg leading-none tracking-tight">Marco Castillo</span>
        <span class="label mt-1 block text-muted">Software Engineer</span>
      </span>
      <span class="sr-only">
        {lang === 'es' ? 'Marco Castillo — inicio' : 'Marco Castillo — home'}
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex xl:gap-7" aria-label={navLabel}>
      {t.header.nav.map((item) => (
        <a
          class="label link-underline text-ink-soft transition-colors hover:text-ink"
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <div
        class="flex h-10 items-center border border-line"
        role="group"
        aria-label={t.header.language}
      >
        <a
          href="/"
          hreflang="es"
          lang="es"
          aria-current={lang === 'es' ? 'page' : undefined}
          class:list={[
            'label inline-flex h-full min-w-9 items-center justify-center px-2.5 transition-colors',
            lang === 'es' ? 'bg-ink text-paper' : 'text-muted hover:text-ink',
          ]}
        >
          ES
        </a>
        <a
          href="/en/"
          hreflang="en"
          lang="en"
          aria-current={lang === 'en' ? 'page' : undefined}
          class:list={[
            'label inline-flex h-full min-w-9 items-center justify-center px-2.5 transition-colors',
            lang === 'en' ? 'bg-ink text-paper' : 'text-muted hover:text-ink',
          ]}
        >
          EN
        </a>
      </div>

      <a href="#contact" class="btn btn-primary hidden lg:inline-flex">
        {t.header.cta}
        <span aria-hidden="true">↗</span>
      </a>

      <details class="group relative lg:hidden" data-mobile-menu>
        <summary
          class="label flex h-10 cursor-pointer list-none items-center gap-2 border border-line px-3 transition-colors hover:border-ink [&::-webkit-details-marker]:hidden"
          aria-label={t.header.menuLabel}
        >
          {t.header.menu}
          <span
            aria-hidden="true"
            class="text-sm leading-none transition-transform group-open:rotate-45"
          >
            ＋
          </span>
        </summary>

        <div class="absolute right-0 top-[calc(100%+0.6rem)] z-50 w-[min(18rem,calc(100vw-2.5rem))] border border-line bg-paper p-2 shadow-[0_24px_70px_rgba(23,21,15,0.18)]">
          <nav aria-label={navLabel}>
            <ul>
              {t.header.nav.map((item, index) => (
                <li>
                  <a
                    href={item.href}
                    class="flex items-center justify-between border-b border-line/70 px-3 py-3.5 text-sm transition-colors last:border-0 hover:text-accent"
                  >
                    <span class="flex items-baseline gap-3">
                      <span class="label text-muted">0{index + 1}</span>
                      {item.label}
                    </span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="#contact" class="btn btn-primary mt-2 w-full">
              {t.header.cta}
              <span aria-hidden="true">↗</span>
            </a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');

  if (menu) {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });

    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        menu.removeAttribute('open');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.removeAttribute('open');
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
