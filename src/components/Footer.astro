---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<footer class="bg-night text-fg">
  <div class="container-page border-t border-white/10 py-8">
    <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3">
        <span class="grid h-8 w-8 place-items-center bg-accent font-serif text-sm text-canvas">
          M
        </span>
        <p class="text-xs leading-relaxed text-fg/60">{t.footer.builtBy}</p>
      </div>

      <p class="label text-fg/50">{t.footer.stack}</p>

      <a
        href="#top"
        class="label link-underline inline-flex items-center gap-2 self-start text-fg/70 hover:text-fg md:self-auto"
      >
        {t.footer.backToTop}
        <span aria-hidden="true">↑</span>
      </a>
    </div>

    <div class="mt-6 flex flex-col gap-2 border-t border-white/10 pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="label text-fg/50">{t.footer.rights}</p>
      <p class="label text-fg/50">44.3894° N / 79.6903° W</p>
    </div>
  </div>
</footer>
