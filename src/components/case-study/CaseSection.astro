---
interface Props {
  id: string;
  index: string;
  label: string;
  title: string;
}

const { id, index, label, title } = Astro.props;
---

<section id={id} class="border-t border-line">
  <div class="container-page section-pad">
    <div class="grid gap-8 md:grid-cols-12">
      <div class="md:col-span-3">
        <div class="md:sticky md:top-28">
          <p class="label text-accent">{index}</p>
          <p class="label mt-2 text-muted">{label}</p>
        </div>
      </div>

      <div class="min-w-0 md:col-span-9">
        <h2
          class="max-w-3xl font-serif text-3xl leading-[1.05] tracking-[-0.03em] md:text-[2.9rem]"
          data-reveal
        >
          {title}
        </h2>

        <div class="mt-8">
          <slot />
        </div>
      </div>
    </div>

    <slot name="wide" />
  </div>
</section>
