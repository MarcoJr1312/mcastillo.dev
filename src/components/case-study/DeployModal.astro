        elapsed: 'Tiempo',
        checking: 'Estado cada 5 s',
        readyStatus: 'Triplanner está listo.',
        readyNote: 'Stack en línea',
        alreadyStatus: 'Triplanner ya estaba despierto.',
        alreadyNote: 'Sin workflow · stack existente',
        errorStatus: 'No se pudo despertar el stack.',
        errorNote: 'Workflow detenido',
        timeoutStatus: 'El stack no respondió en 15 minutos.',
        open: 'Abrir Triplanner',
