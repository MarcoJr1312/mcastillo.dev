        elapsed: 'Elapsed',
        checking: 'Status every 5 s',
        readyStatus: 'Triplanner is ready.',
        readyNote: 'Stack online',
        alreadyStatus: 'Triplanner was already awake.',
        alreadyNote: 'No workflow · existing stack',
        errorStatus: 'Could not wake the stack.',
        errorNote: 'Workflow stopped',
        timeoutStatus: 'The stack did not respond within 15 minutes.',
        open: 'Open Triplanner',
