---

<dialog
  id="triplanner-deploy"
  class="fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] w-[min(44rem,calc(100vw-2rem))] max-w-none overflow-y-auto overscroll-contain border-0 bg-transparent p-0 text-fg backdrop:bg-canvas/85"
  data-app-url={appUrl}
  data-timeout-seconds={timeoutSeconds}
  data-ready-status={copy.readyStatus}
  data-already-status={copy.alreadyStatus}
  data-error-status={copy.errorStatus}
  data-timeout-status={copy.timeoutStatus}
  data-elapsed-label={copy.elapsed}
  data-checking-label={copy.checking}
  data-ready-note={copy.readyNote}
  data-already-note={copy.alreadyNote}
  data-error-note={copy.errorNote}
  data-name-error={copy.nameError}
  data-gate-error={copy.gateError}
  data-rate-error={copy.rateError}
  data-config-error={copy.configError}
  data-email-error={copy.emailError}
  data-wake-error={copy.wakeError}
  data-gate-submit={copy.gateSubmit}
  data-gate-submitting={copy.gateSubmitting}
  data-already-lead={copy.alreadyLead}
  data-pending-still={copy.pendingStill}
  aria-labelledby="triplanner-deploy-title"
  aria-describedby="triplanner-deploy-desc"
>
  <div class="border border-line bg-elevated">
    <div class="flex items-start justify-between gap-6 border-b border-line px-5 py-5 md:px-6">
      <div>
        <p class="label text-accent">{copy.eyebrow}</p>
        <h2
          id="triplanner-deploy-title"
          class="mt-3 font-serif text-3xl leading-none tracking-[-0.03em] md:text-4xl"
        >
          {copy.title}
        </h2>
      </div>

      <button
        type="button"
        class="grid h-9 w-9 shrink-0 place-items-center border border-line text-xl leading-none text-muted transition-colors hover:border-accent hover:text-accent"
        data-deploy-close
        aria-label={copy.close}
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <p
      id="triplanner-deploy-desc"
      class="border-b border-line px-5 py-4 text-sm leading-relaxed text-muted md:px-6"
    >
      {copy.intro}
    </p>

    <div data-deploy-gate class="px-5 py-6 md:px-6">
      <p class="max-w-2xl text-sm leading-relaxed text-fg-soft">{copy.gateLead}</p>
      <p class="mt-2 font-mono text-[0.625rem] uppercase tracking-[0.12em] text-muted">
        {copy.requiredLegend}
      </p>

      <form class="relative mt-6" data-deploy-form novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block sm:col-span-2">
            <span class="flex flex-wrap items-center gap-2">
              <span class="label text-muted">
                {copy.nameLabel}
                <span class="text-accent" aria-hidden="true">
                  *
                </span>
              </span>
              <span class="label border border-accent/50 px-1.5 py-0.5 text-[0.5rem] text-accent-soft">
                {copy.required}
              </span>
            </span>
            <input
              type="text"
              name="name"
              maxlength="80"
              required
              autocomplete="name"
              class="deploy-field"
              placeholder={copy.namePlaceholder}
              data-deploy-name
            />
          </label>

          <label class="block">
            <span class="flex flex-wrap items-center gap-2">
              <span class="label text-muted">{copy.positionLabel}</span>
              <span class="label border border-line px-1.5 py-0.5 text-[0.5rem] text-muted">
                {copy.optional}
              </span>
            </span>
            <select name="position" class="deploy-field deploy-select" data-deploy-position>
              <option value="">{copy.positionNone}</option>
              <option value="recruiter">Recruiter</option>
              <option value="developer">Developer</option>
              <option value="qa">QA</option>
              <option value="devops">DevOps</option>
              <option value="sre">SRE</option>
              <option value="product">Product Manager</option>
              <option value="designer">Designer</option>
              <option value="data">Data Engineer</option>
              <option value="manager">Engineering Manager</option>
              <option value="student">Student</option>
              <option value="other">{copy.positionOther}</option>
            </select>
          </label>

          <label class="block">
            <span class="flex flex-wrap items-center gap-2">
              <span class="label text-muted">{copy.companyLabel}</span>
              <span class="label border border-line px-1.5 py-0.5 text-[0.5rem] text-muted">
                {copy.optional}
              </span>
            </span>
            <select name="company" class="deploy-field deploy-select" data-deploy-company>
              <option value="">{copy.companyNone}</option>
              <option value="freelancer">{copy.companyFreelancer}</option>
              <option value="none">{copy.companyNoCompany}</option>
              <option value="other">{copy.companyOther}</option>
            </select>
          </label>

          <label class="block sm:col-span-2" data-deploy-position-other-wrap hidden>
            <span class="label text-muted">{copy.positionOtherLabel}</span>
            <input
              type="text"
              name="positionOther"
              maxlength="80"
              autocomplete="organization-title"
              class="deploy-field"
              placeholder={copy.positionOtherPlaceholder}
              data-deploy-position-other
            />
          </label>

          <label class="block sm:col-span-2" data-deploy-company-other-wrap hidden>
            <span class="label text-muted">{copy.companyNameLabel}</span>
            <input
              type="text"
              name="companyName"
              maxlength="120"
              autocomplete="organization"
              class="deploy-field"
              placeholder={copy.companyPlaceholder}
              data-deploy-company-other
            />
          </label>

          <label class="block sm:col-span-2">
            <span class="flex flex-wrap items-center gap-2">
              <span class="label text-muted">{copy.linkedinLabel}</span>
              <span class="label border border-line px-1.5 py-0.5 text-[0.5rem] text-muted">
                {copy.optional}
              </span>
            </span>
            <input
              type="text"
              name="linkedin"
              maxlength="200"
              autocomplete="url"
              class="deploy-field"
              placeholder={copy.linkedinPlaceholder}
              data-deploy-linkedin
            />
            <span class="mt-1.5 block font-mono text-[0.5625rem] uppercase tracking-[0.12em] text-muted">
              {copy.linkedinHint}
            </span>
          </label>
        </div>

        <div
          class="pointer-events-none absolute -left-[9999px] top-auto h-px w-px overflow-hidden"
          aria-hidden="true"
        >
          <label>
            Website
            <input
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
              data-deploy-website
            />
          </label>
        </div>

        <div class="mt-5 flex items-start gap-2 border border-line bg-surface px-3 py-2.5 text-xs leading-relaxed text-muted">
          <span aria-hidden="true" class="mt-0.5 text-accent">
            ◇
          </span>
          <p>{copy.privacyNote}</p>
        </div>

        <p
          class="mt-4 hidden border border-accent/40 bg-accent/10 px-3 py-2.5 text-xs leading-relaxed text-accent-soft"
          role="alert"
          data-deploy-form-error
        ></p>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3">
          <button type="submit" class="btn btn-primary" data-deploy-submit>
            <span data-deploy-submit-label>{copy.gateSubmit}</span>
            <span aria-hidden="true">→</span>
          </button>
          <span class="font-mono text-[0.625rem] leading-relaxed text-muted">{copy.emailNote}</span>
        </div>
      </form>
    </div>

    <div data-deploy-progress-view hidden>
      <p
        class="border-b border-line px-5 py-4 text-sm leading-relaxed text-muted md:px-6"
        data-deploy-progress-lead
      >
        {copy.progressLead}
      </p>

      <div class="px-5 py-6 md:px-6">
        <div class="relative">
          <div class="absolute left-[1.125rem] right-[1.125rem] top-[1.125rem] h-px bg-line"></div>
          <div
            class="absolute left-[1.125rem] right-[1.125rem] top-[1.125rem] h-px origin-left scale-x-0 bg-accent transition-transform duration-700 ease-out"
            data-deploy-track
          ></div>

          <ol class="relative grid grid-cols-5 gap-1">
            {copy.steps.map((step, index) => (
              <li
                class="deploy-step flex flex-col items-center text-center"
                data-deploy-step
                data-state="pending"
                data-detail={step.detail}
              >
                <span class="deploy-node" aria-hidden="true">
                  <span class="deploy-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="deploy-check">✓</span>
                  <span class="deploy-error">!</span>
                </span>
                <span class="mt-2 font-mono text-[0.5625rem] uppercase tracking-[0.12em] text-muted">
                  {step.label}
                </span>
              </li>
            ))}
          </ol>
        </div>

        <div class="mt-7">
          <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2">
            <p class="font-mono text-xs leading-relaxed text-fg-soft" aria-live="polite">
              <span data-deploy-status-text>{copy.steps[0].detail}</span>
              <span class="deploy-cursor" aria-hidden="true">
                _
              </span>
            </p>
            <span class="label text-accent" data-deploy-percent>
              0%
            </span>
          </div>

          <div
            class="mt-3 h-1 w-full bg-line"
            role="progressbar"
            aria-label={copy.progress}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            data-deploy-progress
          >
            <div
              class="h-full w-0 bg-accent transition-[width] duration-700 ease-out"
              data-deploy-bar
            ></div>
          </div>

          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 font-mono text-[0.625rem] uppercase tracking-[0.12em] text-muted">
            <span data-deploy-elapsed>{copy.elapsed} 00:00</span>
            <span data-deploy-checking>{copy.checking}</span>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3" data-deploy-actions hidden>
          <a
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            data-deploy-open
            hidden
          >
            {copy.open}
            <span aria-hidden="true">↗</span>
          </a>
          <button type="button" class="btn" data-deploy-retry hidden>
            {copy.retry}
          </button>
        </div>
      </div>
    </div>

    <div data-deploy-pending-view hidden>
      <div class="px-5 py-6 md:px-6">
        <p class="label flex items-center gap-2 text-accent">
          <span class="deploy-spinner" aria-hidden="true"></span>
          {copy.pendingEyebrow}
        </p>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-fg-soft">{copy.pendingLead}</p>

        <div class="mt-5 border border-line bg-surface px-3 py-2.5 text-xs leading-relaxed text-muted">
          <p>{copy.pendingNote}</p>
        </div>

        <p class="mt-4 text-xs leading-relaxed text-muted">
          {copy.pendingAppLink}{' '}
          <a
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline text-fg-soft transition-colors hover:text-accent"
          >
            triplanner.mcastillo.dev ↗
          </a>
        </p>

        <p
          class="mt-3 hidden font-mono text-[0.625rem] uppercase tracking-[0.12em] text-muted"
          data-deploy-pending-status
          role="status"
        ></p>

        <div class="mt-6 flex flex-wrap gap-3">
          <button type="button" class="btn" data-deploy-pending-check>
            {copy.pendingCheck}
          </button>
          <button type="button" class="btn btn-primary" data-deploy-pending-close>
            {copy.pendingClose}
          </button>
        </div>
      </div>
    </div>

    <div class="border-t border-line px-5 py-4 md:px-6">
      <p class="text-xs leading-relaxed text-muted">
        {copy.localLead}{' '}
        <a
          href="https://github.com/MarcoJr1312/local_triplanner"
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline text-fg-soft transition-colors hover:text-accent"
        >
          {copy.localLink}
        </a>
      </p>
    </div>
  </div>
</dialog>

<style>
  dialog[open] {
    animation: deploy-in 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  dialog[open]::backdrop {
    animation: deploy-fade 260ms ease-out;
  }

  :global(html.deploy-open) {
    overflow: hidden;
  }

  .deploy-field {
    margin-top: 0.5rem;
    width: 100%;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    padding: 0.625rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-fg);
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .deploy-field::placeholder {
    color: var(--color-muted);
    opacity: 0.65;
  }

  .deploy-field:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  .deploy-field[aria-invalid='true'] {
    border-color: var(--color-accent);
  }

  .deploy-select {
    cursor: pointer;
  }

  .deploy-node {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    transition:
      border-color 220ms ease,
      background-color 220ms ease,
      color 220ms ease;
  }

  .deploy-step[data-state='active'] .deploy-node {
    border-color: var(--color-accent);
    color: var(--color-accent);
    animation: deploy-pulse 1.6s ease-in-out infinite;
  }

  .deploy-step[data-state='done'] .deploy-node {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-canvas);
  }

  .deploy-step[data-state='error'] .deploy-node {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .deploy-index {
    display: block;
  }

  .deploy-check,
  .deploy-error {
    display: none;
  }

  .deploy-step[data-state='done'] .deploy-index,
  .deploy-step[data-state='error'] .deploy-index {
    display: none;
  }

  .deploy-step[data-state='done'] .deploy-check,
  .deploy-step[data-state='error'] .deploy-error {
    display: block;
  }

  .deploy-cursor {
    display: inline-block;
    margin-left: 0.15em;
    animation: deploy-blink 1s steps(1, end) infinite;
  }

  @keyframes deploy-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes deploy-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes deploy-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(255, 77, 63, 0.35);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(255, 77, 63, 0);
    }
  }

  @keyframes deploy-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  const dialog = document.getElementById('triplanner-deploy') as HTMLDialogElement | null;

  if (dialog) {
    const modal = dialog;
    const appUrl = (modal.dataset.appUrl ?? '').replace(/\/+$/, '');
    const readyStatus = modal.dataset.readyStatus ?? 'Ready';
    const alreadyStatus = modal.dataset.alreadyStatus ?? 'Already online';
    const errorStatus = modal.dataset.errorStatus ?? 'Could not wake the stack';
    const timeoutStatus = modal.dataset.timeoutStatus ?? 'Timed out';
    const elapsedLabel = modal.dataset.elapsedLabel ?? 'Elapsed';
    const checkingLabel = modal.dataset.checkingLabel ?? 'Checking';
    const readyNote = modal.dataset.readyNote ?? 'Online';
    const alreadyNote = modal.dataset.alreadyNote ?? 'No workflow';
    const errorNote = modal.dataset.errorNote ?? 'Stopped';
    const nameError = modal.dataset.nameError ?? 'Name is required.';
    const gateError = modal.dataset.gateError ?? 'Could not verify the request. Try again.';
    const rateError = modal.dataset.rateError ?? 'Too many requests. Try again later.';
    const configError = modal.dataset.configError ?? 'Deploy is not configured yet.';
    const emailError = modal.dataset.emailError ?? 'Could not send the email notification.';
    const wakeError = modal.dataset.wakeError ?? 'Could not start the wake workflow.';
    const gateSubmitLabel = modal.dataset.gateSubmit ?? 'Request deploy';
    const gateSubmittingLabel = modal.dataset.gateSubmitting ?? 'Checking…';

    const gate = modal.querySelector<HTMLElement>('[data-deploy-gate]');
    const progressView = modal.querySelector<HTMLElement>('[data-deploy-progress-view]');
    const progressLeadEl = modal.querySelector<HTMLElement>('[data-deploy-progress-lead]');
    const initialProgressLead = progressLeadEl?.textContent ?? '';
    const pendingView = modal.querySelector<HTMLElement>('[data-deploy-pending-view]');
    const pendingStatus = modal.querySelector<HTMLElement>('[data-deploy-pending-status]');
    const pendingCheck = modal.querySelector<HTMLButtonElement>('[data-deploy-pending-check]');
    const pendingClose = modal.querySelector<HTMLButtonElement>('[data-deploy-pending-close]');
    const pendingStill = modal.dataset.pendingStill ?? 'Still pending approval.';
    const alreadyLead = modal.dataset.alreadyLead ?? 'The stack was already online.';
    const form = modal.querySelector<HTMLFormElement>('[data-deploy-form]');
    const formError = modal.querySelector<HTMLElement>('[data-deploy-form-error]');
    const nameInput = modal.querySelector<HTMLInputElement>('[data-deploy-name]');
    const positionSelect = modal.querySelector<HTMLSelectElement>('[data-deploy-position]');
    const positionOtherWrap = modal.querySelector<HTMLElement>('[data-deploy-position-other-wrap]');
    const positionOtherInput = modal.querySelector<HTMLInputElement>(
      '[data-deploy-position-other]',
    );
    const companySelect = modal.querySelector<HTMLSelectElement>('[data-deploy-company]');
    const companyOtherWrap = modal.querySelector<HTMLElement>('[data-deploy-company-other-wrap]');
    const companyOtherInput = modal.querySelector<HTMLInputElement>('[data-deploy-company-other]');
    const linkedinInput = modal.querySelector<HTMLInputElement>('[data-deploy-linkedin]');
    const honeypot = modal.querySelector<HTMLInputElement>('[data-deploy-website]');
    const submitButton = modal.querySelector<HTMLButtonElement>('[data-deploy-submit]');
    const submitLabel = modal.querySelector<HTMLElement>('[data-deploy-submit-label]');

    const steps = Array.from(modal.querySelectorAll<HTMLElement>('[data-deploy-step]'));
    const stageDetails = steps.map((step) => step.dataset.detail ?? '');
    const statusText = modal.querySelector<HTMLElement>('[data-deploy-status-text]');
    const percentEl = modal.querySelector<HTMLElement>('[data-deploy-percent]');
    const elapsedEl = modal.querySelector<HTMLElement>('[data-deploy-elapsed]');
    const checkingEl = modal.querySelector<HTMLElement>('[data-deploy-checking]');
    const bar = modal.querySelector<HTMLElement>('[data-deploy-bar]');
    const track = modal.querySelector<HTMLElement>('[data-deploy-track]');
    const progress = modal.querySelector<HTMLElement>('[data-deploy-progress]');
    const actions = modal.querySelector<HTMLElement>('[data-deploy-actions]');
    const openLink = modal.querySelector<HTMLAnchorElement>('[data-deploy-open]');
    const retryButton = modal.querySelector<HTMLButtonElement>('[data-deploy-retry]');
    const closeButton = modal.querySelector<HTMLButtonElement>('[data-deploy-close]');
    const deployButtons = document.querySelectorAll<HTMLButtonElement>('[data-repo-deploy]');
    const ctaLabel = document.querySelector<HTMLElement>('[data-deploy-cta-label]');
    const ctaSpinner = document.querySelector<HTMLElement>('[data-deploy-cta-spinner]');
    const ctaArrow = document.querySelector<HTMLElement>('[data-deploy-cta-arrow]');
    const ctaNote = document.querySelector<HTMLElement>('[data-deploy-cta-note]');
    const deployLabel = ctaLabel?.textContent ?? 'Deploy';
    const waitingLabel = deployButtons[0]?.dataset.waitingLabel ?? 'Waiting for approval';

    const expectedSeconds = 600;
    const pollMs = 5000;
    const statusTimeoutMs = 6000;
    const minReadySeconds = 3;
    const stageThresholds = [0, 12, 60, 180, 360];

    let elapsed = 0;
    let currentStage = 0;
    let readyDetected = false;
    let started = false;
    let submitting = false;
    let polling = false;
    let waitingForApproval = false;
    let session = 0;
    let timeoutSeconds = Number(modal.dataset.timeoutSeconds ?? 900);
    let tickId: number | undefined;
    let pollId: number | undefined;
    let statusController: AbortController | undefined;

    function setStepState(index: number, state: 'pending' | 'active' | 'done' | 'error') {
      const step = steps[index];
      if (step) step.dataset.state = state;
    }

    function updateStages(activeIndex: number) {
      steps.forEach((_, index) => {
        setStepState(
          index,
          index < activeIndex ? 'done' : index === activeIndex ? 'active' : 'pending',
        );
      });
    }

    function setProgress(percent: number) {
      const value = Math.max(0, Math.min(100, Math.round(percent)));
      if (bar) bar.style.width = `${value}%`;
      if (track) track.style.transform = `scaleX(${value / 100})`;
      if (percentEl) percentEl.textContent = `${value}%`;
      progress?.setAttribute('aria-valuenow', String(value));
    }

    function setElapsed(seconds: number) {
      if (!elapsedEl) return;
      const minutes = Math.floor(seconds / 60)
        .toString()
        .padStart(2, '0');
      const rest = (seconds % 60).toString().padStart(2, '0');
      elapsedEl.textContent = `${elapsedLabel} ${minutes}:${rest}`;
    }

    function setPhase(phase: 'gate' | 'loading' | 'ready' | 'error' | 'pending') {
      modal.dataset.phase = phase;
      if (actions) actions.hidden = phase === 'gate' || phase === 'loading' || phase === 'pending';
      if (openLink) openLink.hidden = phase !== 'ready';
      if (retryButton) retryButton.hidden = phase !== 'error';
      if (checkingEl) {
        checkingEl.textContent =
          phase === 'ready' ? readyNote : phase === 'error' ? errorNote : checkingLabel;
      }
    }

    function stopTimers() {
      if (tickId !== undefined) window.clearInterval(tickId);
      if (pollId !== undefined) window.clearInterval(pollId);
      statusController?.abort();
      tickId = undefined;
      pollId = undefined;
      statusController = undefined;
      polling = false;
    }

    function finishReady() {
      if (!started) return;
      stopTimers();
      started = false;
      setPhase('ready');
      steps.forEach((_, index) => setStepState(index, 'done'));
      setProgress(100);
      if (statusText) statusText.textContent = readyStatus;
      openLink?.focus();
    }

    function showAlreadyReady() {
      stopTimers();
      session += 1;
      started = false;
      readyDetected = true;
      setPhase('ready');
      steps.forEach((_, index) => setStepState(index, 'done'));
      setProgress(100);
      setElapsed(0);
      if (progressLeadEl) progressLeadEl.textContent = alreadyLead;
      if (statusText) statusText.textContent = alreadyStatus;
      if (checkingEl) checkingEl.textContent = alreadyNote;
      openLink?.focus();
    }

    function finishError(message = errorStatus) {
      if (!started) return;
      stopTimers();
      started = false;
      setPhase('error');
      setStepState(currentStage, 'error');
      if (statusText) statusText.textContent = message;
    }

    function tick(activeSession: number) {
      if (activeSession !== session) return;

      elapsed += 1;
      setElapsed(elapsed);

      if (!readyDetected) {
        currentStage = Math.max(
          0,
          stageThresholds.findLastIndex((threshold) => elapsed >= threshold),
        );
        updateStages(currentStage);
        if (statusText) statusText.textContent = stageDetails[currentStage] ?? '';
        setProgress(Math.min(94, (elapsed / expectedSeconds) * 100));
      }

      if (readyDetected && elapsed >= minReadySeconds) {
        finishReady();
        return;
      }

      if (elapsed >= timeoutSeconds) {
        finishError(timeoutStatus);
      }
    }

    async function check(activeSession: number) {
      if (activeSession !== session || !started || readyDetected || polling) return;

      const controller = new AbortController();
      statusController = controller;
      const timeoutId = window.setTimeout(() => controller.abort(), statusTimeoutMs);
      polling = true;

      try {
        const response = await fetch(`/api/deploy-status?ts=${Date.now()}`, {
          method: 'GET',
          cache: 'no-store',
          headers: { accept: 'application/json' },
          signal: controller.signal,
        });
        if (!response.ok) return;

        const data = (await response.json()) as { state?: string };
        if (activeSession !== session || !started) return;

        if (data.state === 'awake') {
          readyDetected = true;
          if (elapsed >= minReadySeconds) finishReady();
        } else if (data.state === 'error') {
          finishError(errorStatus);
        }
      } catch {
        // Keep polling on transient network errors.
      } finally {
        window.clearTimeout(timeoutId);
        if (statusController === controller) statusController = undefined;
        polling = false;
      }
    }

    function startProgress() {
      stopTimers();
      session += 1;
      const activeSession = session;
      elapsed = 0;
      currentStage = 0;
      readyDetected = false;
      started = true;
      timeoutSeconds = Number(modal.dataset.timeoutSeconds ?? 900);

      setPhase('loading');
      setElapsed(0);
      setProgress(0);
      updateStages(0);
      if (progressLeadEl) progressLeadEl.textContent = initialProgressLead;
      if (statusText) statusText.textContent = stageDetails[0] ?? '';

      tickId = window.setInterval(() => tick(activeSession), 1000);
      pollId = window.setInterval(() => check(activeSession), pollMs);
      void check(activeSession);
    }

    async function checkPendingStatus() {
      if (!pendingCheck) return;
      pendingCheck.disabled = true;

      try {
        const response = await fetch(`/api/deploy-status?ts=${Date.now()}`, {
          method: 'GET',
          cache: 'no-store',
          headers: { accept: 'application/json' },
        });
        if (!response.ok) throw new Error('status_unavailable');

        const data = (await response.json()) as { state?: string };
        if (data.state === 'awake') {
          if (pendingView) pendingView.hidden = true;
          if (progressView) progressView.hidden = false;
          showAlreadyReady();
        } else if (data.state === 'waking') {
          if (pendingView) pendingView.hidden = true;
          if (progressView) progressView.hidden = false;
          startProgress();
        } else if (pendingStatus) {
          pendingStatus.textContent = pendingStill;
          pendingStatus.hidden = false;
        }
      } catch {
        if (pendingStatus) {
          pendingStatus.textContent = gateError;
          pendingStatus.hidden = false;
        }
      } finally {
        pendingCheck.disabled = false;
      }
    }

    function showFormError(message: string) {
      if (!formError) return;
      formError.textContent = message;
      formError.hidden = false;
      nameInput?.setAttribute('aria-invalid', message ? 'true' : 'false');
    }

    function clearFormError() {
      if (formError) {
        formError.textContent = '';
        formError.hidden = true;
      }
      nameInput?.removeAttribute('aria-invalid');
    }

    function setSubmitting(value: boolean) {
      submitting = value;
      if (submitButton) submitButton.disabled = value;
      if (submitLabel) submitLabel.textContent = value ? gateSubmittingLabel : gateSubmitLabel;
    }

    function resolveCompany() {
      const value = companySelect?.value ?? '';
      if (value === 'other') return (companyOtherInput?.value ?? '').trim();
      if (value === 'freelancer' || value === 'none') return value;
      return '';
    }

    function resolvePosition() {
      const value = positionSelect?.value ?? '';
      if (value === 'other') return (positionOtherInput?.value ?? '').trim();
      return value;
    }

    function resetGate() {
      stopTimers();
      session += 1;
      started = false;
      readyDetected = false;
      setPhase('gate');
      if (gate) gate.hidden = false;
      if (progressView) progressView.hidden = true;
      if (pendingView) pendingView.hidden = true;
      if (pendingStatus) {
        pendingStatus.hidden = true;
        pendingStatus.textContent = '';
      }
      clearFormError();
      setSubmitting(false);
      if (positionOtherWrap && positionSelect?.value !== 'other') positionOtherWrap.hidden = true;
      if (companyOtherWrap && companySelect?.value !== 'other') companyOtherWrap.hidden = true;
    }

    function showPendingView() {
      if (gate) gate.hidden = true;
      if (progressView) progressView.hidden = true;
      if (pendingView) pendingView.hidden = false;
      if (pendingStatus) {
        pendingStatus.hidden = true;
        pendingStatus.textContent = '';
      }
      setPhase('pending');
    }

    function setWaitingState(waiting: boolean) {
      waitingForApproval = waiting;
      if (ctaLabel) ctaLabel.textContent = waiting ? waitingLabel : deployLabel;
      if (ctaSpinner) ctaSpinner.hidden = !waiting;
      if (ctaArrow) ctaArrow.hidden = waiting;
      if (ctaNote) ctaNote.hidden = !waiting;
    }

    function openPending() {
      if (typeof modal.showModal !== 'function') {
        if (appUrl) window.open(appUrl, '_blank', 'noopener');
        return;
      }

      stopTimers();
      session += 1;
      started = false;
      showPendingView();
      if (!modal.open) modal.showModal();
      document.documentElement.classList.add('deploy-open');
      pendingCheck?.focus();
    }

    function openModal() {
      if (typeof modal.showModal !== 'function') {
        if (appUrl) window.open(appUrl, '_blank', 'noopener');
        return;
      }

      resetGate();
      if (!modal.open) modal.showModal();
      document.documentElement.classList.add('deploy-open');
      window.setTimeout(() => nameInput?.focus(), 80);
    }

    companySelect?.addEventListener('change', () => {
      const isOther = companySelect.value === 'other';
      if (companyOtherWrap) companyOtherWrap.hidden = !isOther;
      if (isOther) companyOtherInput?.focus();
    });

    positionSelect?.addEventListener('change', () => {
      const isOther = positionSelect.value === 'other';
      if (positionOtherWrap) positionOtherWrap.hidden = !isOther;
      if (isOther) positionOtherInput?.focus();
    });

    nameInput?.addEventListener('input', () => {
      if (nameInput.value.trim()) clearFormError();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;

      clearFormError();
      const name = (nameInput?.value ?? '').normalize('NFC').trim();
      if (!name) {
        showFormError(nameError);
        nameInput?.focus();
        return;
      }

      setSubmitting(true);

      try {
        const response = await fetch('/api/deploy-request', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name,
            position: resolvePosition(),
            company: resolveCompany(),
            linkedin: (linkedinInput?.value ?? '').trim(),
            website: honeypot?.value ?? '',
          }),
        });

        const data = (await response.json().catch(() => ({}))) as {
          stack?: 'online' | 'waking' | 'pending';
          error?: string;
        };

        if (!response.ok) {
          if (response.status === 429 && data.error === 'approval_pending') {
            setWaitingState(true);
            showPendingView();
            return;
          }

          const messages: Record<string, string> = {
            invalid_name: nameError,
            rate_limited: rateError,
            not_configured: configError,
            email_failed: emailError,
            wake_failed: wakeError,
          };
          const errorKey = data.error ?? '';
          showFormError(Object.hasOwn(messages, errorKey) ? messages[errorKey] : gateError);
          return;
        }

        if (gate) gate.hidden = true;
        if (progressView) progressView.hidden = true;
        if (pendingView) pendingView.hidden = true;

        if (data.stack === 'online') {
          if (progressView) progressView.hidden = false;
          showAlreadyReady();
        } else if (data.stack === 'waking') {
          if (progressView) progressView.hidden = false;
          startProgress();
        } else {
          setWaitingState(true);
          showPendingView();
        }
      } catch {
        showFormError(gateError);
      } finally {
        setSubmitting(false);
      }
    });

    deployButtons.forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (waitingForApproval) {
          openPending();
          return;
        }
        openModal();
      });
    });

    closeButton?.addEventListener('click', () => modal.close());
    pendingClose?.addEventListener('click', () => modal.close());
    pendingCheck?.addEventListener('click', () => {
      void checkPendingStatus();
    });
    retryButton?.addEventListener('click', () => {
      resetGate();
      nameInput?.focus();
    });

    modal.addEventListener('click', (event) => {
      if (event.target === dialog) modal.close();
    });

    modal.addEventListener('close', () => {
      started = false;
      stopTimers();
      document.documentElement.classList.remove('deploy-open');
    });

    void fetch('/api/deploy-session', {
      method: 'GET',
      cache: 'no-store',
      headers: { accept: 'application/json' },
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((data: { pending?: boolean } | null) => {
        if (data?.pending) setWaitingState(true);
      })
      .catch(() => {
        // The session endpoint is only available on the deployed site.
      });
  }
</script>
