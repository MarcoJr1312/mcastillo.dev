  lang: Lang;
  appUrl?: string;
  timeoutSeconds?: number;
}

const { lang, appUrl = 'https://triplanner.mcastillo.dev', timeoutSeconds = 900 } = Astro.props;

const copy =
  lang === 'es'
    ? {
