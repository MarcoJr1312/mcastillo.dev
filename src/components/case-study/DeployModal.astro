          'Deja tus datos para que el dueño del sitio revise la solicitud. El deploy no se ejecutará hasta que lo apruebe. Solo el nombre es obligatorio.',
        requiredLegend: 'Los campos con * son obligatorios.',
        required: 'Obligatorio',
        optional: 'Opcional',
        nameLabel: 'Nombre',
        namePlaceholder: 'Tu nombre',
        positionLabel: 'Posición',
        positionNone: 'No especificar',
        positionOther: 'Otra posición',
        positionOtherLabel: 'Especifica la posición',
