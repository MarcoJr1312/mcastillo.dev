          { label: 'DNS', detail: 'Resolviendo el DNS y el certificado TLS' },
          { label: 'VPC', detail: 'Creando VPC, subredes y security groups' },
          { label: 'DB', detail: 'Aprovisionando Postgres y el catálogo de lugares' },
          { label: 'ECS', detail: 'Iniciando web, API y agente en Fargate' },
          { label: 'HTTP', detail: 'Esperando el health check del ALB' },
        ],
      }
    : {
        eyebrow: 'Deploy · ephemeral stack',
        title: 'Wake Triplanner',
        intro:
          'The AWS stack wakes on demand. Before running the workflow, we check whether it is already online.',
        gateLead:
          'Leave your details for the site owner to review. The deploy will not run until it is approved. Only the name is required.',
        requiredLegend: 'Fields marked with * are required.',
        required: 'Required',
        optional: 'Optional',
        nameLabel: 'Name',
        namePlaceholder: 'Your name',
        positionLabel: 'Position',
        positionNone: 'Not specified',
        positionOther: 'Other position',
        positionOtherLabel: 'Specify the position',
        positionOtherPlaceholder: 'e.g. Technical Recruiter',
        companyLabel: 'Company',
        companyNone: 'Not specified',
        companyFreelancer: 'Freelancer',
        companyNoCompany: 'Not affiliated with any company',
        companyOther: 'Other company',
        companyNameLabel: 'Company name',
