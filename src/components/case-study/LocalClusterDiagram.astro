---
import type { Lang } from '../../i18n/content';
import type { LocalCaseStudy } from '../../i18n/localTripPlanner';

interface Props {
  lang: Lang;
  study: LocalCaseStudy;
}

const { lang, study } = Astro.props;

const t =
  lang === 'es'
    ? {
        cluster: 'CLÚSTER KIND · triplanner',
        services: 'SERVICIOS',
        databases: 'BASES DE DATOS',
        control: 'OBSERVABILIDAD Y ENTREGA',
        browser: ['itinerario y calendario', 'invitaciones y adjuntos'],
        gateway: ['solo publica la web', 'interno: ClusterIP'],
        web: ['/api/graphql → facade', '/api/agent/* → agente', '/uploads/* → API'],
        api: ['GraphQL público', 'clientes gRPC', 'auth + membresía', 'uploads + invitaciones'],
        agent: ['Agno · solo lectura', 'embeddings pgvector', 'LLM opcional'],
        users: ['cuentas · login', 'notificaciones · favoritos'],
        trips: ['viajes · miembros', 'ítems · recordatorios'],
        locations: ['catálogo · MongoDB', 'HasData BYOK'],
        usersDb: 'cuentas y sesiones',
        tripsDb: 'viajes e ítems',
        mongoDb: 'lugares y cache TTL',
        apiDb: 'GraphQL + uploads',
        agentDb: ['pgvector', 'embeddings'],
        broker: ['topic/offset/ack'],
        email: ['long-poll', 'retry + DLQ'],
        external: ['invitaciones', 'recordatorios'],
        prometheus: '13 targets · 11 dashboards',
        exporters: '4 PostgreSQL + 1 MongoDB',
        argocd: 'Synced / Healthy · HEAD',
        labels: {
          https: 'HTTPS',
          route: 'HTTPRoute',
          graphql: '/api/graphql',
          agent: '/api/agent/*',
          grpc: 'gRPC h2c',
          publish: 'publish',
          poll: 'poll / ack',
          send: 'send',
          internal: 'internal token',
          pgvector: 'pgvector',
          apiDb: 'GraphQL data',
        },
        scroll: 'Desliza el diagrama →',
      }
    : {
        cluster: 'KIND CLUSTER · triplanner',
        services: 'SERVICES',
        databases: 'DATABASES',
        control: 'OBSERVABILITY AND DELIVERY',
        browser: ['itinerary and calendar', 'invitations and attachments'],
        gateway: ['only publishes the web app', 'internal: ClusterIP'],
        web: ['/api/graphql → facade', '/api/agent/* → agent', '/uploads/* → API'],
        api: ['public GraphQL', 'gRPC clients', 'auth + membership', 'uploads + invitations'],
        agent: ['Agno · read-only', 'pgvector embeddings', 'optional LLM'],
        users: ['accounts · login', 'notifications · favorites'],
        trips: ['trips · members', 'items · reminders'],
        locations: ['catalogue · MongoDB', 'HasData BYOK'],
        usersDb: 'accounts and sessions',
        tripsDb: 'trips and items',
        mongoDb: 'places and TTL cache',
        apiDb: 'GraphQL + uploads',
        agentDb: ['pgvector', 'embeddings'],
        broker: ['topic/offset/ack'],
        email: ['long-poll', 'retry + DLQ'],
        external: ['invitations', 'reminders'],
        prometheus: '13 targets · 11 dashboards',
        exporters: '4 PostgreSQL + 1 MongoDB',
        argocd: 'Synced / Healthy · HEAD',
        labels: {
          https: 'HTTPS',
          route: 'HTTPRoute',
          graphql: '/api/graphql',
          agent: '/api/agent/*',
          grpc: 'gRPC h2c',
          publish: 'publish',
          poll: 'poll / ack',
          send: 'send',
          internal: 'internal token',
          pgvector: 'pgvector',
          apiDb: 'GraphQL data',
        },
        scroll: 'Scroll the diagram →',
      };
---

<figure class="mt-10 border border-line bg-surface/40 p-4 md:p-6">
  <div
    class="overflow-x-auto"
    tabindex="0"
    role="region"
    aria-label={study.architecture.diagramTitle}
  >
    <svg
      viewBox="0 0 1040 690"
      class="h-auto w-full min-w-[820px]"
      role="img"
      aria-labelledby={`cluster-title-${lang}`}
      aria-describedby={`cluster-desc-${lang}`}
    >
      <title id={`cluster-title-${lang}`}>{study.architecture.diagramTitle}</title>
      <desc id={`cluster-desc-${lang}`}>{study.architecture.diagramDesc}</desc>

      <style>
        .cl-box {
          fill: var(--color-surface);
          stroke: var(--color-line);
          stroke-width: 1;
        }
        .cl-box-inner {
          fill: var(--color-elevated);
          stroke: var(--color-line);
          stroke-width: 1;
        }
        .cl-accent {
          fill: var(--color-accent);
        }
        .cl-title {
          fill: var(--color-fg);
          font-family: var(--font-mono);
          font-size: 12px;
          font-weight: 600;
          letter-spacing: 0.9px;
        }
        .cl-sub {
          fill: var(--color-muted);
          font-family: var(--font-mono);
          font-size: 9.5px;
          letter-spacing: 0.2px;
        }
        .cl-text {
          fill: var(--color-fg-soft);
          font-family: var(--font-sans);
          font-size: 10.5px;
        }
        .cl-label {
          fill: var(--color-muted);
          font-family: var(--font-mono);
          font-size: 8.5px;
          letter-spacing: 0.5px;
        }
        .cl-head {
          fill: var(--color-muted);
          font-family: var(--font-mono);
          font-size: 9px;
          letter-spacing: 1.8px;
        }
        .cl-line {
          stroke: var(--color-line);
          stroke-width: 1;
          fill: none;
        }
        .cl-arrow {
          stroke: var(--color-muted);
          stroke-width: 1.1;
          fill: none;
        }
        .cl-arrow-accent {
          stroke: var(--color-accent);
          stroke-width: 1.1;
          fill: none;
        }
        .cl-boundary {
          fill: none;
          stroke: var(--color-line);
          stroke-width: 1;
          stroke-dasharray: 4 5;
        }
        .cl-junction {
          fill: var(--color-line);
        }
      </style>

      <defs>
        <marker
          id="cl-arrow"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L8,4 L0,8 z" fill="var(--color-muted)"></path>
        </marker>
        <marker
          id="cl-arrow-accent"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L8,4 L0,8 z" fill="var(--color-accent)"></path>
        </marker>
      </defs>

      <!-- Cluster boundary and headers -->
      <rect class="cl-boundary" x="8" y="8" width="1024" height="664"></rect>
      <text class="cl-head" x="22" y="30">
        {t.cluster}
      </text>
      <text class="cl-head" x="580" y="30">
        {t.services}
      </text>
      <text class="cl-head" x="830" y="30">
        {t.databases}
      </text>

      <!-- Browser -->
      <g>
        <rect class="cl-box" x="20" y="44" width="170" height="54"></rect>
        <rect class="cl-accent" x="20" y="44" width="170" height="3"></rect>
        <text class="cl-title" x="36" y="68">
          BROWSER
        </text>
        <text class="cl-text" x="36" y="84">
          {t.browser[0]}
        </text>
      </g>

      <!-- Cilium Gateway -->
      <g>
        <rect class="cl-box" x="20" y="122" width="170" height="88"></rect>
        <rect class="cl-accent" x="20" y="122" width="170" height="3"></rect>
        <text class="cl-title" x="36" y="146">
          CILIUM GATEWAY
        </text>
        <text class="cl-sub" x="36" y="162">
          HTTPRoute · :9080
        </text>
        <line class="cl-line" x1="36" y1="172" x2="174" y2="172"></line>
        <text class="cl-text" x="36" y="190">
          {t.gateway[0]}
        </text>
        <text class="cl-text" x="36" y="204">
          {t.gateway[1]}
        </text>
      </g>

      <!-- Web -->
      <g>
        <rect class="cl-box" x="20" y="250" width="170" height="100"></rect>
        <rect class="cl-accent" x="20" y="250" width="170" height="3"></rect>
        <text class="cl-title" x="36" y="274">
          NEXT.JS 15
        </text>
        <text class="cl-sub" x="36" y="290">
          {lang === 'es' ? 'único origen público' : 'only public origin'}
        </text>
        <line class="cl-line" x1="36" y1="300" x2="174" y2="300"></line>
        <text class="cl-text" x="36" y="318">
          {t.web[0]}
        </text>
        <text class="cl-text" x="36" y="332">
          {t.web[1]}
        </text>
      </g>

      <!-- API facade -->
      <g>
        <rect class="cl-box" x="270" y="160" width="210" height="160"></rect>
        <rect class="cl-accent" x="270" y="160" width="210" height="3"></rect>
        <text class="cl-title" x="286" y="184">
          API FACADE
        </text>
        <text class="cl-sub" x="286" y="200">
          Bun · graphql-yoga · :4000
        </text>
        <line class="cl-line" x1="286" y1="210" x2="464" y2="210"></line>
        <text class="cl-text" x="286" y="228">
          {t.api[0]}
        </text>
        <text class="cl-text" x="286" y="244">
          {t.api[1]}
        </text>
        <text class="cl-text" x="286" y="260">
          {t.api[2]}
        </text>
        <text class="cl-text" x="286" y="276">
          {t.api[3]}
        </text>
        <text class="cl-label" x="286" y="304">
          {lang === 'es' ? 'token interno' : 'internal token'}
        </text>
      </g>

      <!-- Agent -->
      <g>
        <rect class="cl-box" x="270" y="390" width="210" height="110"></rect>
        <rect class="cl-accent" x="270" y="390" width="210" height="3"></rect>
        <text class="cl-title" x="286" y="414">
          AGENT
        </text>
        <text class="cl-sub" x="286" y="430">
          Python · FastAPI · :4100
        </text>
        <line class="cl-line" x1="286" y1="440" x2="464" y2="440"></line>
        <text class="cl-text" x="286" y="458">
          {t.agent[0]}
        </text>
        <text class="cl-text" x="286" y="472">
          {t.agent[1]}
        </text>
        <text class="cl-text" x="286" y="486">
          {t.agent[2]}
        </text>
      </g>

      <!-- Services -->
      <g>
        <rect class="cl-box" x="580" y="70" width="180" height="84"></rect>
        <rect class="cl-accent" x="580" y="70" width="180" height="3"></rect>
        <text class="cl-title" x="596" y="94">
          USERS
        </text>
        <text class="cl-sub" x="596" y="110">
          Bun · gRPC :50051
        </text>
        <text class="cl-text" x="596" y="130">
          {t.users[0]}
        </text>
        <text class="cl-text" x="596" y="144">
          {t.users[1]}
        </text>
      </g>

      <g>
        <rect class="cl-box" x="580" y="174" width="180" height="84"></rect>
        <rect class="cl-accent" x="580" y="174" width="180" height="3"></rect>
        <text class="cl-title" x="596" y="198">
          TRIPS
        </text>
        <text class="cl-sub" x="596" y="214">
          Bun · gRPC :50052
        </text>
        <text class="cl-text" x="596" y="234">
          {t.trips[0]}
        </text>
        <text class="cl-text" x="596" y="248">
          {t.trips[1]}
        </text>
      </g>

      <g>
        <rect class="cl-box" x="580" y="278" width="180" height="84"></rect>
        <rect class="cl-accent" x="580" y="278" width="180" height="3"></rect>
        <text class="cl-title" x="596" y="302">
          LOCATIONS
        </text>
        <text class="cl-sub" x="596" y="318">
          Bun · gRPC :50053
        </text>
        <text class="cl-text" x="596" y="338">
          {t.locations[0]}
        </text>
        <text class="cl-text" x="596" y="352">
          {t.locations[1]}
        </text>
      </g>

      <!-- Databases -->
      <g>
        <rect class="cl-box" x="830" y="70" width="190" height="84"></rect>
        <text class="cl-title" x="846" y="94">
          POSTGRESQL
        </text>
        <text class="cl-sub" x="846" y="110">
          users-postgres
        </text>
        <text class="cl-text" x="846" y="132">
          {t.usersDb}
        </text>
      </g>

      <g>
        <rect class="cl-box" x="830" y="174" width="190" height="84"></rect>
        <text class="cl-title" x="846" y="198">
          POSTGRESQL
        </text>
        <text class="cl-sub" x="846" y="214">
          trips-postgres
        </text>
        <text class="cl-text" x="846" y="236">
          {t.tripsDb}
        </text>
      </g>

      <g>
        <rect class="cl-box" x="830" y="278" width="190" height="84"></rect>
        <text class="cl-title" x="846" y="302">
          MONGODB 7
        </text>
        <text class="cl-sub" x="846" y="318">
          catalogue
        </text>
        <text class="cl-text" x="846" y="340">
          {t.mongoDb}
        </text>
      </g>

      <g>
        <rect class="cl-box" x="830" y="382" width="190" height="84"></rect>
        <text class="cl-title" x="846" y="406">
          POSTGRESQL
        </text>
        <text class="cl-sub" x="846" y="422">
          api-postgres
        </text>
        <text class="cl-text" x="846" y="444">
          {t.apiDb}
        </text>
      </g>

      <g>
        <rect class="cl-box" x="830" y="486" width="190" height="84"></rect>
        <text class="cl-title" x="846" y="510">
          POSTGRESQL
        </text>
        <text class="cl-sub" x="846" y="526">
          agent-postgres
        </text>
        <text class="cl-text" x="846" y="546">
          {t.agentDb[0]}
        </text>
        <text class="cl-text" x="846" y="560">
          {t.agentDb[1]}
        </text>
      </g>

      <!-- Broker, email, external -->
      <g>
        <rect class="cl-box" x="540" y="510" width="100" height="62"></rect>
        <text class="cl-title" x="554" y="532">
          BROKER
        </text>
        <text class="cl-sub" x="554" y="547">
          Go · :8080
        </text>
        <text class="cl-label" x="554" y="563">
          {t.broker[0]}
        </text>
      </g>

      <g>
        <rect class="cl-box" x="660" y="510" width="100" height="62"></rect>
        <text class="cl-title" x="674" y="532">
          EMAIL
        </text>
        <text class="cl-sub" x="674" y="547">
          Bun · :4200
        </text>
        <text class="cl-label" x="674" y="563">
          {t.email[0]}
        </text>
      </g>

      <g>
        <rect class="cl-box" x="800" y="510" width="150" height="62"></rect>
        <text class="cl-title" x="814" y="532">
          RESEND / SINK
        </text>
        <text class="cl-sub" x="814" y="547">
          {lang === 'es' ? 'externo' : 'external'}
        </text>
        <text class="cl-label" x="814" y="563">
          {t.external[0]}
        </text>
      </g>

      <!-- Connections -->
      <path class="cl-arrow" d="M105,98 V122" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="113" y="114">
        {t.labels.https}
      </text>

      <path class="cl-arrow" d="M105,210 V250" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="113" y="234">
        {t.labels.route}
      </text>

      <path class="cl-arrow" d="M190,290 H230 V240 H270" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="232" y="268" text-anchor="middle">
        {t.labels.graphql}
      </text>

      <path class="cl-arrow" d="M105,350 V445 H270" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="170" y="438" text-anchor="middle">
        {t.labels.agent}
      </text>

      <path class="cl-arrow" d="M375,390 V320" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="383" y="360">
        {t.labels.internal}
      </text>

      <path class="cl-arrow" d="M480,200 H520 V112 H580" marker-end="url(#cl-arrow)"></path>
      <path class="cl-arrow" d="M480,240 H530 V216 H580" marker-end="url(#cl-arrow)"></path>
      <path class="cl-arrow" d="M480,280 H530 V320 H580" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="528" y="132">
        {t.labels.grpc}
      </text>

      <path class="cl-arrow" d="M480,310 H505 V541 H540" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="512" y="470">
        {t.labels.publish}
      </text>

      <path class="cl-arrow" d="M640,541 H660" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="650" y="502" text-anchor="middle">
        {t.labels.poll}
      </text>

      <path class="cl-arrow" d="M760,541 H800" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="780" y="530" text-anchor="middle">
        {t.labels.send}
      </text>

      <path class="cl-arrow" d="M480,445 H780 V528 H830" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="788" y="490">
        {t.labels.pgvector}
      </text>

      <path class="cl-arrow" d="M480,300 H520 V424 H830" marker-end="url(#cl-arrow)"></path>
      <text class="cl-label" x="770" y="418" text-anchor="end">
        {t.labels.apiDb}
      </text>

      <path class="cl-arrow" d="M760,112 H830" marker-end="url(#cl-arrow)"></path>
      <path class="cl-arrow" d="M760,216 H830" marker-end="url(#cl-arrow)"></path>
      <path class="cl-arrow" d="M760,320 H830" marker-end="url(#cl-arrow)"></path>

      <!-- Control band -->
      <line class="cl-line" x1="22" y1="590" x2="1018" y2="590"></line>
      <text class="cl-head" x="22" y="606">
        {t.control}
      </text>

      <g>
        <rect class="cl-box-inner" x="22" y="616" width="320" height="46"></rect>
        <text class="cl-title" x="36" y="636">
          PROMETHEUS + GRAFANA
        </text>
        <text class="cl-sub" x="36" y="652">
          {t.prometheus}
        </text>
      </g>

      <g>
        <rect class="cl-box-inner" x="360" y="616" width="300" height="46"></rect>
        <text class="cl-title" x="374" y="636">
          EXPORTERS
        </text>
        <text class="cl-sub" x="374" y="652">
          {t.exporters}
        </text>
      </g>

      <g>
        <rect class="cl-box-inner" x="680" y="616" width="340" height="46"></rect>
        <text class="cl-title" x="694" y="636">
          ARGO CD · triplanner-agrocd
        </text>
        <text class="cl-sub" x="694" y="652">
          {t.argocd}
        </text>
      </g>
    </svg>
  </div>

  <figcaption class="mt-4 flex flex-col gap-1 border-t border-line pt-4 text-xs leading-relaxed text-muted">
    <span>{study.architecture.caption}</span>
    <span>{study.architecture.note}</span>
    <span class="label mt-1 text-accent lg:hidden">{t.scroll}</span>
  </figcaption>
</figure>
