---
import type { Lang } from '../../i18n/content';
import type { ProjectCaseStudy } from '../../i18n/projects';

interface Props {
  lang: Lang;
  study: ProjectCaseStudy;
}

const { lang, study } = Astro.props;

const t =
  lang === 'es'
    ? {
        controlLabel: 'SIEMPRE ACTIVO — CONTROL PLANE',
        appLabel: 'EFÍMERO — SE APLICA AL DESPERTAR Y SE DESTRUYE AL DORMIR',
        control: [
          ['GITHUB ACTIONS', 'wake · sleep', 'status-page', 'OIDC → AWS', 'apply / destroy'],
          [
            'CONTROL API',
            'API Gateway · HTTP',
            'POST /wake · GET /status',
            'admin · AWS_IAM',
            'repository_dispatch',
          ],
          [
            'EVENTBRIDGE',
            'sleep-check Lambda',
            'cada 5 min',
            '30 min sin tráfico',
            'dispara sleep',
          ],
          [
            'STATUS PAGE',
            'Cloudflare Pages',
            'asleep · waking · awake',
            'botón de despertar',
            'fuera de AWS',
          ],
          ['ESTADO', 'DynamoDB control', 'S3 tfstate', 'ECR + ACM', 'GitHub token'],
        ],
        internet: ['INTERNET', 'usuario'],
        cloudflare: ['CLOUDFLARE', 'edge · DNS + proxy', '→ ALB · despierto', '→ Pages · dormido'],
        alb: ['ALB + WAF', 'solo IPs de Cloudflare', 'TLS 1.3', 'rate limit por IP'],
        ecs: ['ECS FARGATE', 'web · api · agent', 'Cloud Map privado'],
        data: [
          ['RDS POSTGRES 16', 'Single-AZ · pgvector', 'se borra al dormir'],
          ['DYNAMODB', 'catálogo de lugares', 'se borra al dormir'],
          ['S3 + KMS', 'adjuntos', 'se borra al dormir'],
        ],
        cycle: 'terraform apply / destroy',
      }
    : {
        controlLabel: 'ALWAYS ON — CONTROL PLANE',
        appLabel: 'EPHEMERAL — APPLIED ON WAKE, DESTROYED ON SLEEP',
        control: [
          ['GITHUB ACTIONS', 'wake · sleep', 'status-page', 'OIDC → AWS', 'apply / destroy'],
          [
            'CONTROL API',
            'API Gateway · HTTP',
            'POST /wake · GET /status',
            'admin · AWS_IAM',
            'repository_dispatch',
          ],
          [
            'EVENTBRIDGE',
            'sleep-check Lambda',
            'every 5 min',
            '30 min without traffic',
            'dispatch sleep',
          ],
          [
            'STATUS PAGE',
            'Cloudflare Pages',
            'asleep · waking · awake',
            'wake button',
            'outside AWS',
          ],
          ['STATE', 'DynamoDB control', 'S3 tfstate', 'ECR + ACM', 'GitHub token'],
        ],
        internet: ['INTERNET', 'user'],
        cloudflare: ['CLOUDFLARE', 'edge · DNS + proxy', '→ ALB · awake', '→ Pages · asleep'],
        alb: ['ALB + WAF', 'Cloudflare IPs only', 'TLS 1.3', 'per-IP rate limit'],
        ecs: ['ECS FARGATE', 'web · api · agent', 'private Cloud Map'],
        data: [
          ['RDS POSTGRES 16', 'Single-AZ · pgvector', 'destroyed on sleep'],
          ['DYNAMODB', 'location catalogue', 'destroyed on sleep'],
          ['S3 + KMS', 'attachments', 'destroyed on sleep'],
        ],
        cycle: 'terraform apply / destroy',
      };

const controlX = [44, 229, 414, 599, 784];
const controlWidth = 172;
const dataX = [414, 614, 814];
const dataWidth = [170, 170, 142];
---

<figure class="mt-10 border border-line bg-surface/40 p-4 md:p-6">
  <div
    class="overflow-x-auto"
    tabindex="0"
    role="region"
    aria-label={study.infrastructure.diagramTitle}
  >
    <svg
      viewBox="0 0 1000 620"
      class="h-auto w-full min-w-[720px]"
      role="img"
      aria-labelledby={`eph-title-${lang}`}
      aria-describedby={`eph-desc-${lang}`}
    >
      <title id={`eph-title-${lang}`}>{study.infrastructure.diagramTitle}</title>
      <desc id={`eph-desc-${lang}`}>{study.infrastructure.diagramDesc}</desc>

      <style>
        .eph-box {
          fill: var(--color-surface);
          stroke: var(--color-line);
          stroke-width: 1;
        }
        .eph-panel {
          fill: none;
          stroke: var(--color-line);
          stroke-width: 1;
        }
        .eph-accent {
          fill: var(--color-accent);
        }
        .eph-title {
          fill: var(--color-fg);
          font-family: var(--font-mono);
          font-size: 12px;
          font-weight: 600;
          letter-spacing: 0.9px;
        }
        .eph-text {
          fill: var(--color-fg-soft);
          font-family: var(--font-sans);
          font-size: 11px;
        }
        .eph-mono {
          fill: var(--color-muted);
          font-family: var(--font-mono);
          font-size: 9.5px;
        }
        .eph-head {
          fill: var(--color-muted);
          font-family: var(--font-mono);
          font-size: 9.5px;
          letter-spacing: 2px;
        }
        .eph-line {
          stroke: var(--color-line);
          stroke-width: 1;
          fill: none;
        }
        .eph-arrow {
          stroke: var(--color-muted);
          stroke-width: 1.1;
          fill: none;
        }
        .eph-arrow-accent {
          stroke: var(--color-accent);
          stroke-width: 1.1;
          fill: none;
          stroke-dasharray: 5 4;
        }
      </style>

      <defs>
        <marker
          id="eph-arrow"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L8,4 L0,8 z" fill="var(--color-muted)"></path>
        </marker>
        <marker
          id="eph-arrow-accent"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L8,4 L0,8 z" fill="var(--color-accent)"></path>
        </marker>
      </defs>

      <!-- Control plane -->
      <rect class="eph-panel" x="24" y="36" width="952" height="196" stroke-dasharray="6 5"></rect>
      <text class="eph-head" x="40" y="60">
        {t.controlLabel}
      </text>

      <g>
        {t.control.map((box, index) => (
          <g>
            <rect
              class="eph-box"
              x={controlX[index]}
              y="78"
              width={controlWidth}
              height="124"
            ></rect>
            <text class="eph-title" x={controlX[index] + 16} y="104">
              {box[0]}
            </text>
            {box.slice(1).map((line, lineIndex) => (
              <text class="eph-mono" x={controlX[index] + 16} y={126 + lineIndex * 18}>
                {line}
              </text>
            ))}
          </g>
        ))}
      </g>

      <path class="eph-arrow-accent" d="M130,202 V300" marker-end="url(#eph-arrow-accent)"></path>
      <text class="eph-mono" x="142" y="258">
        {t.cycle}
      </text>

      <!-- Ephemeral stack -->
      <rect class="eph-panel" x="24" y="300" width="952" height="300"></rect>
      <text class="eph-head" x="40" y="324">
        {t.appLabel}
      </text>

      <g>
        <rect class="eph-box" x="44" y="344" width="140" height="94"></rect>
        <text class="eph-title" x="60" y="370">
          {t.internet[0]}
        </text>
        <text class="eph-text" x="60" y="392">
          {t.internet[1]}
        </text>

        <rect class="eph-box" x="214" y="344" width="170" height="94"></rect>
        <text class="eph-title" x="230" y="370">
          {t.cloudflare[0]}
        </text>
        <text class="eph-text" x="230" y="392">
          {t.cloudflare[1]}
        </text>
        <text class="eph-text" x="230" y="410">
          {t.cloudflare[2]}
        </text>
        <text class="eph-text" x="230" y="428">
          {t.cloudflare[3]}
        </text>

        <rect class="eph-box" x="414" y="344" width="170" height="94"></rect>
        <text class="eph-title" x="430" y="370">
          {t.alb[0]}
        </text>
        <text class="eph-text" x="430" y="392">
          {t.alb[1]}
        </text>
        <text class="eph-text" x="430" y="410">
          {t.alb[2]}
        </text>
        <text class="eph-text" x="430" y="428">
          {t.alb[3]}
        </text>

        <rect class="eph-box" x="614" y="344" width="170" height="94"></rect>
        <rect class="eph-accent" x="614" y="344" width="170" height="3"></rect>
        <text class="eph-title" x="630" y="370">
          {t.ecs[0]}
        </text>
        <text class="eph-text" x="630" y="392">
          {t.ecs[1]}
        </text>
        <text class="eph-text" x="630" y="410">
          {t.ecs[2]}
        </text>
      </g>

      <g>
        {t.data.map((box, index) => (
          <g>
            <rect
              class="eph-box"
              x={dataX[index]}
              y="472"
              width={dataWidth[index]}
              height="94"
            ></rect>
            <text class="eph-title" x={dataX[index] + 16} y="498">
              {box[0]}
            </text>
            <text class="eph-text" x={dataX[index] + 16} y="520">
              {box[1]}
            </text>
            <text class="eph-mono" x={dataX[index] + 16} y="538">
              {box[2]}
            </text>
          </g>
        ))}
      </g>

      <!-- Connections -->
      <path class="eph-arrow" d="M184,391 H214" marker-end="url(#eph-arrow)"></path>
      <path class="eph-arrow" d="M384,391 H414" marker-end="url(#eph-arrow)"></path>
      <path class="eph-arrow" d="M584,391 H614" marker-end="url(#eph-arrow)"></path>

      <path class="eph-arrow" d="M640,438 V454 H499 V472" marker-end="url(#eph-arrow)"></path>
      <path class="eph-arrow" d="M699,438 V472" marker-end="url(#eph-arrow)"></path>
      <path class="eph-arrow" d="M760,438 V454 H884 V472" marker-end="url(#eph-arrow)"></path>
    </svg>
  </div>

  <figcaption class="mt-4 flex flex-col gap-1 border-t border-line pt-4 text-xs leading-relaxed text-muted">
    <span>{study.infrastructure.caption}</span>
    <span>{study.infrastructure.note}</span>
    <span class="label mt-1 text-accent lg:hidden">
      {lang === 'es' ? 'Desliza el diagrama →' : 'Scroll the diagram →'}
    </span>
  </figcaption>
</figure>
