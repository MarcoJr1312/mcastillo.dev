---
import type { Lang } from '../../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy =
  lang === 'es'
    ? {
        eyebrow: 'AWS · stack efímero',
        title: 'Stack AWS efímero en construcción.',
        body: 'Estoy rehaciendo el flujo de wake/sleep y la infraestructura del demo. La vista del repositorio y el botón de deploy vuelven cuando el stack esté estable. Por ahora, la demo local es la única opción disponible.',
        building: 'Construyendo',
        paused: 'En espera',
        loop: 'Ciclo de build',
        complete: 'Build en espera · volviendo a empezar',
        localCta: 'Ir a la demo local',
        stages: [
          { label: 'DNS', detail: 'Resolviendo el DNS y el certificado TLS' },
          { label: 'VPC', detail: 'Creando VPC, subredes y security groups' },
          { label: 'DB', detail: 'Aprovisionando Postgres y el catálogo de lugares' },
          { label: 'ECS', detail: 'Iniciando web, API y agente en Fargate' },
          { label: 'HTTP', detail: 'Esperando el health check del ALB' },
        ],
      }
    : {
        eyebrow: 'AWS · ephemeral stack',
        title: 'Ephemeral AWS stack under construction.',
        body: 'I am rebuilding the wake/sleep flow and the demo infrastructure. The repository preview and deploy button will return once the stack is stable. For now, the local demo is the only available option.',
        building: 'Building',
        paused: 'Paused',
        loop: 'Build loop',
        complete: 'Build paused · starting over',
        localCta: 'Go to the local demo',
        stages: [
          { label: 'DNS', detail: 'Resolving DNS and the TLS certificate' },
          { label: 'VPC', detail: 'Creating the VPC, subnets, and security groups' },
          { label: 'DB', detail: 'Provisioning Postgres and the location catalogue' },
          { label: 'ECS', detail: 'Starting web, API, and agent on Fargate' },
          { label: 'HTTP', detail: 'Waiting for the ALB health check' },
        ],
      };
---

<aside
  class="border border-line bg-elevated"
  data-stack-notice
  data-building={copy.building}
  data-paused={copy.paused}
  data-complete={copy.complete}
>
  <div class="border-b border-line px-5 py-5 md:px-6">
    <p class="label flex items-center gap-2 text-accent">
      <span class="status-dot"></span>
      {copy.eyebrow}
    </p>
    <h3 class="mt-3 max-w-2xl font-serif text-2xl leading-snug md:text-[1.75rem]">{copy.title}</h3>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{copy.body}</p>
  </div>

  <div class="px-5 py-6 md:px-6">
    <div class="relative" aria-hidden="true">
      <div class="absolute left-[1.125rem] right-[1.125rem] top-[1.125rem] h-px bg-line"></div>
      <div
        class="absolute left-[1.125rem] right-[1.125rem] top-[1.125rem] h-px origin-left scale-x-0 bg-accent transition-transform duration-700 ease-out"
        data-notice-track
      ></div>

      <ol class="relative grid grid-cols-5 gap-1">
        {copy.stages.map((stage, index) => (
          <li
            class="notice-step flex flex-col items-center text-center"
            data-notice-step
            data-state="pending"
            data-detail={stage.detail}
          >
            <span class="notice-node" aria-hidden="true">
              <span class="notice-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="notice-check">✓</span>
            </span>
            <span class="mt-2 font-mono text-[0.5625rem] uppercase tracking-[0.12em] text-muted">
              {stage.label}
            </span>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-7" aria-hidden="true">
      <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2">
        <p class="font-mono text-xs leading-relaxed text-fg-soft">
          <span data-notice-status>{copy.stages[0].detail}</span>
          <span class="notice-cursor" aria-hidden="true">
            _
          </span>
        </p>
        <span class="label text-accent" data-notice-percent>
          0%
        </span>
      </div>

      <div
        class="mt-3 h-1 w-full bg-line"
        role="progressbar"
        aria-label={copy.loop}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-notice-progress
      >
        <div
          class="h-full w-0 bg-accent transition-[width] duration-700 ease-out"
          data-notice-bar
        ></div>
      </div>

      <div class="mt-3 flex flex-wrap items-center justify-between gap-2 font-mono text-[0.625rem] uppercase tracking-[0.12em] text-muted">
        <span>{copy.loop}</span>
        <span data-notice-phase>{copy.building}</span>
      </div>
    </div>

    <div class="mt-6 border-t border-line pt-4">
      <a href="#local-demo" class="btn btn-primary">
        {copy.localCta}
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</aside>

<style>
  .notice-node {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    transition:
      border-color 220ms ease,
      background-color 220ms ease,
      color 220ms ease;
  }

  .notice-step[data-state='active'] .notice-node {
    border-color: var(--color-accent);
    color: var(--color-accent);
    animation: notice-pulse 1.6s ease-in-out infinite;
  }

  .notice-step[data-state='done'] .notice-node {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-canvas);
  }

  .notice-index {
    display: block;
  }

  .notice-check {
    display: none;
  }

  .notice-step[data-state='done'] .notice-index {
    display: none;
  }

  .notice-step[data-state='done'] .notice-check {
    display: block;
  }

  .notice-cursor {
    display: inline-block;
    margin-left: 0.15em;
    animation: notice-blink 1s steps(1, end) infinite;
  }

  @keyframes notice-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(255, 77, 63, 0.35);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(255, 77, 63, 0);
    }
  }

  @keyframes notice-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  const notice = document.querySelector<HTMLElement>('[data-stack-notice]');

  if (notice) {
    const steps = Array.from(notice.querySelectorAll<HTMLElement>('[data-notice-step]'));
    const details = steps.map((step) => step.dataset.detail ?? '');
    const status = notice.querySelector<HTMLElement>('[data-notice-status]');
    const percent = notice.querySelector<HTMLElement>('[data-notice-percent]');
    const bar = notice.querySelector<HTMLElement>('[data-notice-bar]');
    const track = notice.querySelector<HTMLElement>('[data-notice-track]');
    const progress = notice.querySelector<HTMLElement>('[data-notice-progress]');
    const phase = notice.querySelector<HTMLElement>('[data-notice-phase]');
    const copy = {
      building: notice.dataset.building ?? 'Building',
      paused: notice.dataset.paused ?? 'Paused',
      complete: notice.dataset.complete ?? 'Build paused',
    };

    let step = 0;
    let timer = 0;
    let resetTimer = 0;

    function paint(activeIndex: number, complete = false) {
      steps.forEach((stepEl, index) => {
        stepEl.dataset.state =
          complete || index < activeIndex ? 'done' : index === activeIndex ? 'active' : 'pending';
      });

      const value = complete ? 100 : Math.round((activeIndex / steps.length) * 100);
      if (bar) bar.style.width = `${value}%`;
      if (track) track.style.transform = `scaleX(${value / 100})`;
      if (percent) percent.textContent = `${value}%`;
      progress?.setAttribute('aria-valuenow', String(value));

      if (status) {
        status.textContent = complete ? copy.complete : (details[activeIndex] ?? '');
      }
      if (phase) phase.textContent = complete ? copy.paused : copy.building;
    }

    function start() {
      step = 0;
      paint(0);
      timer = window.setInterval(() => {
        step += 1;
        if (step < steps.length) {
          paint(step);
          return;
        }

        window.clearInterval(timer);
        paint(steps.length, true);
        resetTimer = window.setTimeout(start, 2000);
      }, 1200);
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      paint(steps.length, true);
      if (status) status.textContent = copy.paused;
    } else {
      start();
    }

    window.addEventListener('pagehide', () => {
      window.clearInterval(timer);
      window.clearTimeout(resetTimer);
    });
  }
</script>
