---
import type { Lang } from '../../i18n/content';
import type { LocalCaseStudy } from '../../i18n/localTripPlanner';
import CaseSection from './CaseSection.astro';
import LocalClusterDiagram from './LocalClusterDiagram.astro';

interface Props {
  lang: Lang;
  study: LocalCaseStudy;
}

const { lang, study } = Astro.props;
const home = lang === 'es' ? '/es/' : '/';
const copy =
  lang === 'es'
    ? {
        summary: 'Resumen',
        contact: 'Hablemos',
        clonePrefix: 'Clona el repositorio',
        docs: 'Documentación',
        fullSize: 'Ver a tamaño completo',
      }
    : {
        summary: 'Summary',
        contact: "Let's talk",
        clonePrefix: 'Clone the repository',
        docs: 'Documentation',
        fullSize: 'View full size',
      };

const lastSlash = study.repo.cloneCommand.lastIndexOf('/');
const clonePrefix = study.repo.cloneCommand.slice(0, lastSlash + 1);
const cloneSuffix = study.repo.cloneCommand.slice(lastSlash + 1);
---

<article>
  <header class="relative overflow-hidden border-b border-line">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="container-page relative pb-14 pt-8 md:pb-20 md:pt-10">
      <a
        href={`${home}#work`}
        class="label link-underline inline-flex items-center gap-2 text-muted transition-colors hover:text-fg"
      >
        <span aria-hidden="true">←</span>
        {study.labels.backToWork}
      </a>

      <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-8">
          <p class="label text-accent">{study.kicker}</p>

          <h1 class="mt-5 max-w-4xl font-serif text-[clamp(2.6rem,6.6vw,5.75rem)] leading-[0.96] tracking-[-0.045em]">
            {study.title}
          </h1>

          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-fg-soft md:text-xl">{study.lead}</p>
        </div>

        <aside class="lg:col-span-4 lg:pl-4 xl:pl-8">
          <div class="border border-line bg-elevated">
            <div class="flex items-center justify-between border-b border-line px-5 py-3">
              <span class="label">{study.name}</span>
              <span class="label text-muted">{study.year}</span>
            </div>

            <dl>
              {study.meta.map((row) => (
                <div class="grid grid-cols-[4.5rem_1fr] gap-3 border-b border-line/70 px-5 py-3.5 last:border-b-0">
                  <dt class="label pt-0.5 text-muted">{row.label}</dt>
                  <dd class="text-sm leading-snug text-fg-soft">{row.value}</dd>
                </div>
              ))}
            </dl>

            <div class="flex items-center gap-2 border-t border-line/70 px-5 py-4">
              <span class="status-dot"></span>
              <span class="label text-fg-soft">{study.status}</span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </header>

  <div class="container-page">
    <div class="grid gap-8 border-b border-line py-10 md:grid-cols-12 md:py-12">
      <p class="label text-muted md:col-span-3">{copy.summary}</p>
      <p class="drop-cap max-w-3xl text-base leading-relaxed text-fg-soft md:col-span-9 md:text-lg">
        {study.abstract}
      </p>
    </div>

    <nav
      aria-label={study.labels.toc}
      class="flex flex-wrap gap-x-6 gap-y-2 border-b border-line py-4"
    >
      <span class="label text-muted">{study.labels.toc}</span>
      {study.toc.map((item) => (
        <a
          href={item.href}
          class="label link-underline text-fg-soft transition-colors hover:text-accent"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <CaseSection
    id={study.baseline.id}
    index={study.baseline.index}
    label={study.baseline.label}
    title={study.baseline.title}
  >
    <div class="max-w-3xl space-y-5 text-base leading-relaxed text-fg-soft">
      {study.baseline.body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <dl class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {study.baseline.facts.map((fact, index) => (
        <div class="bg-surface p-5 md:p-6" data-reveal style={`--reveal-delay:${index * 60}ms`}>
          <dt class="font-serif text-4xl leading-none text-fg md:text-5xl">{fact.value}</dt>
          <dd class="mt-2">
            <span class="label text-accent">{fact.label}</span>
            <span class="mt-2 block text-xs leading-relaxed text-muted">{fact.note}</span>
          </dd>
        </div>
      ))}
    </dl>

    <div class="mt-12">
      <p class="label text-muted">{study.baseline.constraintsLabel}</p>

      <ul class="mt-5 grid gap-px border border-line bg-line sm:grid-cols-2">
        {study.baseline.constraints.map((item, index) => (
          <li class="bg-surface p-5 md:p-6" data-reveal style={`--reveal-delay:${index * 60}ms`}>
            <span class="label text-accent">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-serif text-xl leading-snug">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </CaseSection>

  <CaseSection
    id={study.method.id}
    index={study.method.index}
    label={study.method.label}
    title={study.method.title}
  >
    <p class="max-w-3xl text-base leading-relaxed text-fg-soft">{study.method.body}</p>

    <div class="mt-10">
      <p class="label text-muted">{study.method.gatesLabel}</p>

      <ol class="mt-5 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {study.method.gates.map((gate, index) => (
          <li class="bg-surface p-4 md:p-5" data-reveal style={`--reveal-delay:${index * 45}ms`}>
            <span class="label text-accent">G{gate.id}</span>
            <h3 class="mt-2 font-serif text-lg leading-none">{gate.title}</h3>
            <p class="mt-3 text-xs leading-relaxed text-muted">{gate.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-12">
      <p class="label text-muted">{study.method.timelineLabel}</p>

      <ol class="mt-5 divide-y divide-line border-y border-line">
        {study.method.timeline.map((step, index) => (
          <li
            class="grid gap-2 py-5 md:grid-cols-12 md:gap-8"
            data-reveal
            style={`--reveal-delay:${index * 40}ms`}
          >
            <p class="label text-accent md:col-span-3">{step.phase}</p>
            <div class="md:col-span-9">
              <h3 class="font-serif text-xl leading-snug">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </CaseSection>

  <CaseSection
    id={study.architecture.id}
    index={study.architecture.index}
    label={study.architecture.label}
    title={study.architecture.title}
  >
    <div class="max-w-3xl space-y-5 text-base leading-relaxed text-fg-soft">
      {study.architecture.body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <div class="mt-10">
      <ol class="grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {study.architecture.flow.map((step, index) => (
          <li class="bg-surface p-5" data-reveal style={`--reveal-delay:${index * 60}ms`}>
            <span class="label text-accent">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-serif text-lg leading-none">{step.label}</h3>
            <p class="mt-3 text-xs leading-relaxed text-muted">{step.detail}</p>
          </li>
        ))}
      </ol>
    </div>

    <Fragment slot="wide">
      <LocalClusterDiagram lang={lang} study={study} />

      <div class="mt-6 md:mt-8">
        <p class="label text-muted">{study.architecture.deliveryLabel}</p>

        <ul class="mt-3 grid gap-px border border-line bg-line md:grid-cols-3">
          {study.architecture.delivery.map((item, index) => (
            <li class="bg-elevated p-5" data-reveal style={`--reveal-delay:${index * 60}ms`}>
              <p class="label text-muted">{item.label}</p>
              <p class="mt-2 font-mono text-sm text-fg">{item.value}</p>
              <p class="mt-2 text-xs leading-relaxed text-muted">{item.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </Fragment>
  </CaseSection>

  <CaseSection
    id={study.decisions.id}
    index={study.decisions.index}
    label={study.decisions.label}
    title={study.decisions.title}
  >
    <p class="max-w-3xl text-base leading-relaxed text-fg-soft">{study.decisions.intro}</p>

    <div class="mt-10 space-y-4">
      {study.decisions.items.map((decision) => (
        <article class="border border-line bg-surface/60 p-6 md:p-8" data-reveal>
          <div class="flex items-center justify-between gap-4">
            <span class="label text-accent">{decision.id}</span>
            <span class="label text-muted">{lang === 'es' ? 'Registro' : 'Record'}</span>
          </div>

          <h3 class="mt-4 font-serif text-2xl leading-snug md:text-[1.75rem]">{decision.title}</h3>

          <dl class="mt-6 grid gap-5 md:grid-cols-3 md:gap-6">
            <div>
              <dt class="label text-muted">{study.decisions.labels.context}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-fg-soft">{decision.context}</dd>
            </div>
            <div>
              <dt class="label text-accent">{study.decisions.labels.decision}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-fg-soft">{decision.decision}</dd>
            </div>
            <div>
              <dt class="label text-muted">{study.decisions.labels.tradeoff}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-muted">{decision.tradeoff}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </CaseSection>

  <CaseSection
    id={study.observability.id}
    index={study.observability.index}
    label={study.observability.label}
    title={study.observability.title}
  >
    <div class="max-w-3xl space-y-5 text-base leading-relaxed text-fg-soft">
      {study.observability.body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <dl class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {study.observability.stats.map((stat, index) => (
        <div class="bg-surface p-5 md:p-6" data-reveal style={`--reveal-delay:${index * 60}ms`}>
          <dt class="font-serif text-3xl leading-none text-fg md:text-4xl">{stat.value}</dt>
          <dd class="mt-2">
            <span class="label text-accent">{stat.label}</span>
            <span class="mt-2 block text-xs leading-relaxed text-muted">{stat.note}</span>
          </dd>
        </div>
      ))}
    </dl>

    <Fragment slot="wide">
      <div class="mt-10 md:mt-12">
        <div class="grid gap-4 lg:grid-cols-2">
          {study.observability.screenshots.map((shot, index) => (
            <figure
              class:list={[
                'overflow-hidden border border-line bg-elevated',
                index === 0 ? 'lg:col-span-2' : '',
                index === study.observability.screenshots.length - 1
                  ? 'lg:col-span-2 lg:mx-auto lg:w-[calc(50%_-_0.5rem)]'
                  : '',
              ]}
              data-reveal
              style={`--reveal-delay:${index * 50}ms`}
            >
              <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
                <span class="label text-fg-soft">{shot.title}</span>
                <span class="label text-muted">{String(index + 1).padStart(2, '0')}</span>
              </div>

              <a
                href={shot.src}
                target="_blank"
                rel="noopener noreferrer"
                class="block"
                aria-label={`${copy.fullSize}: ${shot.title}`}
              >
                <img
                  src={shot.src}
                  alt={shot.alt}
                  width="1440"
                  height="1400"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="h-auto w-full border-b border-line"
                />
              </a>

              <figcaption class="px-4 py-3 text-xs leading-relaxed text-muted">
                <span class="block">{shot.caption}</span>
                <a
                  href={shot.src}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 flex w-fit items-center gap-1 font-mono text-[0.625rem] uppercase tracking-[0.12em] text-accent transition-opacity hover:opacity-80"
                >
                  {copy.fullSize}
                  <span aria-hidden="true">↗</span>
                </a>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="mt-4 border border-line bg-surface/60 px-5 py-4 text-xs leading-relaxed text-muted">
          <p>{study.observability.caption}</p>
          <p class="mt-2">{study.observability.note}</p>
        </div>
      </div>
    </Fragment>
  </CaseSection>

  <CaseSection
    id={study.learnings.id}
    index={study.learnings.index}
    label={study.learnings.label}
    title={study.learnings.title}
  >
    <ul class="grid gap-px border border-line bg-line sm:grid-cols-2">
      {study.learnings.items.map((item, index) => (
        <li
          class:list={[
            'bg-surface p-6',
            index === study.learnings.items.length - 1 ? 'sm:col-span-2' : '',
          ]}
          data-reveal
          style={`--reveal-delay:${index * 60}ms`}
        >
          <span class="label text-accent">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 font-serif text-xl leading-snug">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
        </li>
      ))}
    </ul>
  </CaseSection>

  <section id="repo" class="scroll-mt-28 border-t border-line">
    <div class="container-page section-pad">
      <div class="grid gap-px border border-line bg-line lg:grid-cols-[1.1fr_0.9fr]">
        <div class="bg-elevated p-6 md:p-10">
          <p class="label text-accent">{study.repo.label}</p>
          <h2 class="mt-4 max-w-xl font-serif text-3xl leading-[1.05] tracking-[-0.03em] md:text-[2.9rem]">
            {study.repo.title}
          </h2>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-fg-soft">{study.repo.body}</p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href={study.repo.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              {study.repo.repoLabel}
              <span aria-hidden="true">↗</span>
            </a>
            <a href={study.repo.docsUrl} target="_blank" rel="noopener noreferrer" class="btn">
              {study.repo.docsLabel}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="min-w-0 bg-surface p-6 md:p-10">
          <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
            <p class="label text-muted">{study.repo.cloneLabel}</p>
            <button
              type="button"
              class="label border border-line px-2 py-1 text-muted transition-colors hover:border-accent hover:text-accent"
              data-copy-command={study.repo.cloneCommand}
              data-copied={study.repo.copiedLabel}
            >
              {study.repo.copyLabel}
            </button>
          </div>

          <code class="mt-3 block whitespace-pre-wrap break-words border border-line bg-elevated px-3 py-2 font-mono text-[0.6875rem] leading-relaxed text-fg-soft">
            {clonePrefix}
            <wbr />
            {cloneSuffix}
          </code>

          <p class="mt-4 text-xs leading-relaxed text-muted">{study.repo.note}</p>

          <div class="mt-6 border-t border-line pt-5">
            <p class="label text-muted">{copy.docs}</p>
            <a
              href={study.repo.docsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="label link-underline mt-2 inline-flex items-center gap-2 text-accent-soft transition-colors hover:text-accent"
            >
              docs/migrations
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container-page border-t border-line py-10 md:py-12">
    <div class="flex flex-wrap gap-3">
      <a href={`${home}#work`} class="btn">
        <span aria-hidden="true">←</span>
        {study.labels.backToWork}
      </a>
      <a href={`${home}#contact`} class="btn btn-primary">
        {copy.contact}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-command]');

  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const command = button.dataset.copyCommand;
      if (!command) return;

      try {
        await navigator.clipboard.writeText(command);
        const original = button.textContent;
        button.textContent = button.dataset.copied ?? 'Copied';
        window.setTimeout(() => {
          button.textContent = original;
        }, 1600);
      } catch {
        // Clipboard access can be blocked; the command remains selectable.
      }
    });
  });
</script>
