---
import type { ProjectCaseStudy } from '../../i18n/projects';

interface Props {
  study: ProjectCaseStudy;
}

const { study } = Astro.props;
const localRepo = study.localRepo;
const lastSlash = localRepo.cloneCommand.lastIndexOf('/');
const clonePrefix = localRepo.cloneCommand.slice(0, lastSlash + 1);
const cloneSuffix = localRepo.cloneCommand.slice(lastSlash + 1);
---

<aside class="border border-line bg-elevated">
  <div class="grid gap-px bg-line lg:grid-cols-[1.15fr_0.85fr]">
    <div class="bg-elevated p-5 md:p-6">
      <p class="label text-accent">{localRepo.label}</p>
      <h3 class="mt-3 max-w-xl font-serif text-2xl leading-snug md:text-[1.75rem]">
        {localRepo.title}
      </h3>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{localRepo.body}</p>
    </div>

    <div class="min-w-0 bg-surface p-5 md:p-6">
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
        <p class="label text-muted">{localRepo.cloneLabel}</p>
        <button
          type="button"
          class="label border border-line px-2 py-1 text-muted transition-colors hover:border-accent hover:text-accent"
          data-copy-command={localRepo.cloneCommand}
          data-copied={localRepo.copiedLabel}
        >
          {localRepo.copyLabel}
        </button>
      </div>

      <code class="mt-3 block whitespace-pre-wrap break-words border border-line bg-elevated px-3 py-2 font-mono text-[0.6875rem] leading-relaxed text-fg-soft">
        {clonePrefix}
        <wbr />
        {cloneSuffix}
      </code>

      <p class="mt-3 text-xs leading-relaxed text-muted">{localRepo.note}</p>

      <a
        href={localRepo.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="label link-underline mt-4 inline-flex items-center gap-2 text-accent-soft transition-colors hover:text-accent"
      >
        {localRepo.repoLabel}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</aside>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-command]');

  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const command = button.dataset.copyCommand;
      if (!command) return;

      try {
        await navigator.clipboard.writeText(command);
        const original = button.textContent;
        button.textContent = button.dataset.copied ?? 'Copied';
        window.setTimeout(() => {
          button.textContent = original;
        }, 1600);
      } catch {
        // Clipboard access can be blocked; the command remains selectable.
      }
    });
  });
</script>
