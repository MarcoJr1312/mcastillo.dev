---
import type { Lang, Project } from '../i18n/content';

interface Props {
  project: Project;
  lang: Lang;
  delay?: number;
}

const { project, lang, delay = 0 } = Astro.props;
const isLink = Boolean(project.href);
const Tag = isLink ? 'a' : 'div';
---

<Tag
  href={project.href}
  target={isLink ? '_blank' : undefined}
  rel={isLink ? 'noopener noreferrer' : undefined}
  class:list={[
    'group relative -mx-4 grid gap-6 border-t border-line px-4 py-8 transition-colors md:-mx-6 md:grid-cols-12 md:gap-8 md:px-6 md:py-10',
    isLink ? 'hover:bg-paper-deep/55' : '',
  ]}
  data-reveal
  style={`--reveal-delay:${delay}ms`}
>
  <div class="min-w-0 md:col-span-1">
    <span class="label text-muted">{project.index}</span>
  </div>

  <div class="min-w-0 md:col-span-7">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h3 class="font-serif text-3xl leading-none tracking-[-0.03em] transition-colors group-hover:text-accent md:text-5xl">
        {project.name}
      </h3>
      <span class="label text-muted">{project.year}</span>
    </div>

    <p class="mt-4 font-serif text-lg italic text-ink-soft md:text-xl">{project.tagline}</p>

    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">{project.description}</p>

    <ul class="mt-5 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <li class="chip">{tag}</li>
      ))}
    </ul>
  </div>

  <div class="flex min-w-0 flex-row flex-wrap items-end justify-between gap-4 md:col-span-4 md:flex-col md:items-end">
    <div class="text-left md:text-right">
      <p class="label text-muted">{project.domain}</p>
      <p class="label mt-3 flex items-center gap-2 text-ink-soft">
        <span class="h-1.5 w-1.5 flex-none bg-accent"></span>
        {project.status}
      </p>
    </div>

    {isLink && project.linkLabel && (
      <span class="label inline-flex items-center gap-2 border border-line px-3 py-2 text-ink-soft transition-all group-hover:border-ink group-hover:bg-ink group-hover:text-paper">
        {project.linkLabel}
        <span aria-hidden="true">↗</span>
        <span class="sr-only">
          {lang === 'es' ? '(se abre en una pestaña nueva)' : '(opens in a new tab)'}
        </span>
      </span>
    )}
  </div>
</Tag>
