---
// Spanish case studies moved under /es/: /proyectos/<slug>/ -> /es/proyectos/<slug>/
import { caseStudies } from '../../i18n/projects';
import { localCaseStudySlugs } from '../../i18n/localTripPlanner';

export function getStaticPaths() {
  return [...Object.keys(caseStudies), ...localCaseStudySlugs].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

return Astro.redirect(`/es/proyectos/${slug}/`, 301);
---
