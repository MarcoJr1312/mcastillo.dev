---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="404 — Marco Castillo" description="This page does not exist. Yet.">
  <section class="container-page section-pad">
    <p class="label text-accent">404 / Not found</p>

    <h1 class="mt-6 font-serif text-[clamp(4rem,14vw,11rem)] leading-none tracking-[-0.05em]">
      404<span class="text-accent">.</span>
    </h1>

    <p class="mt-6 max-w-lg font-serif text-2xl italic leading-snug">
      This page doesn't exist. Yet.
    </p>
    <p class="mt-3 max-w-lg text-sm text-muted">Esta página no existe. Todavía.</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">
        Back to the home page
        <span aria-hidden="true">→</span>
      </a>
      <a href="/es/" class="btn" hreflang="es" lang="es">
        Ir al inicio en español
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
