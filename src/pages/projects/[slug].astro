---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudy from '../../components/case-study/CaseStudy.astro';
import { caseStudies } from '../../i18n/projects';

export function getStaticPaths() {
  return Object.keys(caseStudies).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const study = slug ? caseStudies[slug]?.en : undefined;

if (!study) {
  throw new Error(`Unknown case study: ${slug}`);
}

const path = `/projects/${study.slug}/`;
const alternateEs = `/es/proyectos/${study.slug}/`;
---

<BaseLayout
  lang="en"
  title={`${study.seoTitle} · Marco Castillo`}
  description={study.lead}
  alternateEs={alternateEs}
  alternateEn={path}
>
  <CaseStudy lang="en" study={study} />
</BaseLayout>
