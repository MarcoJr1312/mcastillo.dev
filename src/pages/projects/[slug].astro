---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudy from '../../components/case-study/CaseStudy.astro';
import LocalCaseStudy from '../../components/case-study/LocalCaseStudy.astro';
import { caseStudies } from '../../i18n/projects';
import { localCaseStudies, localCaseStudySlugs } from '../../i18n/localTripPlanner';

export function getStaticPaths() {
  return [...Object.keys(caseStudies), ...localCaseStudySlugs].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const localStudy = slug ? localCaseStudies[slug]?.en : undefined;
const study = slug ? caseStudies[slug]?.en : undefined;
const pageStudy = localStudy ?? study;

if (!pageStudy) {
  throw new Error(`Unknown case study: ${slug}`);
}

const path = `/projects/${pageStudy.slug}/`;
const alternateEs = `/es/proyectos/${pageStudy.slug}/`;
---

<BaseLayout
  lang="en"
  title={`${pageStudy.seoTitle} · Marco Castillo`}
  description={pageStudy.lead}
  alternateEs={alternateEs}
  alternateEn={path}
>
  {localStudy ? (
    <LocalCaseStudy lang="en" study={localStudy} />
  ) : study ? (
    <CaseStudy lang="en" study={study} />
  ) : null}
</BaseLayout>
