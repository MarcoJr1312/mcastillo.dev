---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudy from '../../../components/case-study/CaseStudy.astro';
import LocalCaseStudy from '../../../components/case-study/LocalCaseStudy.astro';
import { caseStudies } from '../../../i18n/projects';
import { localCaseStudies, localCaseStudySlugs } from '../../../i18n/localTripPlanner';

export function getStaticPaths() {
  return [...Object.keys(caseStudies), ...localCaseStudySlugs].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const localStudy = slug ? localCaseStudies[slug]?.es : undefined;
const study = slug ? caseStudies[slug]?.es : undefined;
const pageStudy = localStudy ?? study;

if (!pageStudy) {
  throw new Error(`Unknown case study: ${slug}`);
}

const path = `/es/proyectos/${pageStudy.slug}/`;
const alternateEn = `/projects/${pageStudy.slug}/`;
---

<BaseLayout
  lang="es"
  title={`${pageStudy.seoTitle} · Marco Castillo`}
  description={pageStudy.lead}
  alternateEs={path}
  alternateEn={alternateEn}
>
  {localStudy ? (
    <LocalCaseStudy lang="es" study={localStudy} />
  ) : study ? (
    <CaseStudy lang="es" study={study} />
  ) : null}
</BaseLayout>
