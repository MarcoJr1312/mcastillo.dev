# Vercel → Project → Settings → Environment Variables
# Copy these names into the Vercel dashboard. Never commit real values.

# Resend (https://resend.com). RESEND_FROM must use a verified domain.
RESEND_API_KEY=re_replace_me
RESEND_FROM=mcastillo.dev <deploy@mcastillo.dev>
DEPLOY_NOTIFY_TO=macd.chicho@gmail.com

# Control plane of the ephemeral Triplanner stack.
DEPLOY_STATUS_URL=https://zev4y8ny7l.execute-api.us-east-1.amazonaws.com/status
DEPLOY_WAKE_URL=https://zev4y8ny7l.execute-api.us-east-1.amazonaws.com/wake

# Origins allowed to call the deploy gate (comma-separated).
DEPLOY_ALLOWED_ORIGINS=https://mcastillo.dev,https://www.mcastillo.dev,http://localhost:4321

# Approval links. If DEPLOY_APPROVAL_SECRET is empty, RESEND_API_KEY is used.
# Set a dedicated random value when possible.
DEPLOY_APPROVAL_SECRET=
DEPLOY_APPROVAL_TTL_SECONDS=172800
DEPLOY_PENDING_TTL_SECONDS=1800
DEPLOY_SITE_URL=https://mcastillo.dev
DEPLOY_APP_URL=https://triplanner.mcastillo.dev
